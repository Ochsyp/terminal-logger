#!/usr/bin/env bash
# tlogger: install, remove and report the zsh plugin that records terminal sessions as evidence
# for penetration tests, set its mode and engagement, check where the logs lie, and render, show
# and replay the sessions. It manages a 4-line block at the top of the zsh rc, the plugin files,
# the config and the state folders; the plugin does the recording, on tlogger start or, in auto
# mode, in every new terminal.

# Exit status: 0 done or nothing to change; 1 error or refusal, for status an install in part, for
# verify a changed session, and for doctor a warning or a check it could not decide; 2 usage
# error, or --mode or --yes missing where no terminal can answer; 3 not installed, nothing to
# remove or no session to view; 4 for verify, a finished session left unsealed. Executing the
# file runs main; sourcing it only sets the globals and defines the functions, for tests.
# TLOGGER_SKEL, the file a missing rc is seeded from, exists for tests, as do TLOGGER_PYTHON and
# TLOGGER_SCRIPTREPLAY, which name the python3 and scriptreplay that render, show and replay run,
# TLOGGER_PROC, the /proc whose boot id and processes seal's liveness check reads and whose
# self/mountinfo doctor reads, TLOGGER_SYSFS, the /sys whose block devices doctor follows, and
# TLOGGER_FSTAB, the file doctor reads instead of /etc/fstab; production never sets them.

# =======================================================
#                    GLOBAL SETTINGS
# =======================================================

# The source tree: the folder above the bin/ that holds this file, with every symlink resolved,
# so that current/bin/tlogger names the release folder it belongs to.
SRC_ROOT=$(readlink -f -- "${BASH_SOURCE[0]}" 2> /dev/null) || SRC_ROOT=
SRC_ROOT=${SRC_ROOT%/*}
SRC_ROOT=${SRC_ROOT%/*}

# The files of a release, relative to the source tree. bin/tlogger is the only executable one;
# python3 -I runs libexec/tlogger_view.py.
RELEASE_FILES=(bin/tlogger lib/config.zsh lib/tlogger.zsh
    libexec/legacyblock.awk libexec/rcblock.awk
    libexec/tlogger_view.py VERSION)

# The marker lines around the block; libexec/rcblock.awk holds the same two lines.
START_MARK='# >>> tlogger >>>'
END_MARK='# <<< tlogger <<<'

# A version names a release folder, so it is X.Y.Z with an optional suffix of letters, digits and
# dots, and nothing that can act as a path.
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'

# One MANIFEST line as sha256sum writes it, with ' ' or '*' before the path. Every name in the
# path starts with a letter, a digit or _, so no line can name . or .. or an absolute path.
MANIFEST_RE='^[0-9a-f]{64} [ *]([A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*)$'

# The name backup_rc gives an rc backup: the UTC time, then the 6 characters mktemp picks. Only
# names of this form are pruned, so a file of the user's own in rc-backups stays.
BACKUP_NAME_RE='^zshrc\.[0-9]{8}T[0-9]{6}Z\.[A-Za-z0-9]{6}$'

# The name of a session folder, as the plugin's _tlogger_preflight gives it: the UTC time the
# recording started, then the 6 characters mktemp picks. The names sort in time order.
SESSION_NAME_RE='^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9]{6}$'

# The name of an engagement, a folder in the log folder that holds sessions: letters, digits, .,
# _ and -, at most 64 characters, starting with a letter or a digit. engagement_name_ok also
# refuses MANIFEST and a name shaped like a session id; upper and lower case differ.
ENGAGEMENT_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'

# A positive decimal number as replay's --speed and --maxdelay take it, such as 2, 0.5 or .25;
# positive_decimal also wants a digit other than 0.
DECIMAL_RE='^([0-9]+(\.[0-9]+)?|\.[0-9]+)$'

# The zsh code that prints the paths tlogger needs, one 'TLOGGER_Q:' line each. It runs without
# -f, so the user's .zshenv applies, and the prefix sets its lines apart from anything .zshenv
# prints; the empty first line ends a line .zshenv leaves open. A value that holds a newline
# prints empty, and resolve_paths refuses it. As in zsh, ZDOTDIR falls back to HOME only when it
# is unset, and the XDG folders also when they are empty, as the XDG spec says.
IFS= read -r -d '' ZSH_PATH_QUERY << 'EOF' || true
builtin print
for k v in \
    ZDOTDIR "${ZDOTDIR-$HOME}" \
    XDG_DATA_HOME "${XDG_DATA_HOME:-$HOME/.local/share}" \
    XDG_CONFIG_HOME "${XDG_CONFIG_HOME:-$HOME/.config}" \
    XDG_STATE_HOME "${XDG_STATE_HOME:-$HOME/.local/state}"
do
    if [[ $v == *$'\n'* ]]; then v=; fi
    builtin print -r -- "TLOGGER_Q:$k=$v"
done
EOF

# The zsh code the probe runs in a new interactive shell. It prints its marker line only when
# the plugin has defined the tlogger function; the empty first line ends a line that the
# start-up files leave open.
# shellcheck disable=SC2016 # zsh expands it, not bash.
ZSH_PROBE='builtin print; if (( ${+functions[tlogger]} )); then builtin print -r -- TLOGGER_PROBE:loaded; fi'

# Options, set by the parse functions.
OPT_MODE=
OPT_DRY_RUN=0
OPT_YES=0
OPT_PRINT_ONLY=0
OPT_PURGE_CONFIG=0

# The migration options of install: --remove-block and its two marker lines, --block-sha256 and
# --quarantine. OPT_QUARANTINE is an absolute path once parse_install_options has checked it.
OPT_REMOVE=0
OPT_LEGACY_START=
OPT_LEGACY_END=
OPT_BLOCK_SHA=
OPT_BLOCK_SHA_SET=0
OPT_QUARANTINE=
OPT_QUARANTINE_SET=0

# Paths, set by resolve_paths from what zsh reports.
ZDOT=
DATA_HOME=
CONFIG_HOME=
STATE_HOME=
RC=
DATA_DIR=
RELEASES_DIR=
CURRENT_LINK=
PLUGIN=
CONFIG_DIR=
CONFIG_FILE=
STATE_DIR=
BACKUP_DIR=
QUARANTINE_DIR=
SESSIONS_DIR=

# The version of the source tree, the block, the chosen mode, the backup made, if any, and what
# install did with the code, for the summary.
VERSION_STR=
BLOCK=
MODE=
BACKUP=
CODE_NOTE=

# The rc as found: RC_STATE is regular, missing or foreign (a symlink, a non-regular file or
# another user's file), RC_WHY says why it is foreign, OLD_RC is a private copy of its bytes,
# SEED the file a missing rc starts from, SCANNED the file that copy came from, for messages,
# and RC_CHANGED whether the new rc differs.
RC_STATE=
RC_WHY=
OLD_RC=
SEED=
SCANNED=
RC_CHANGED=0

# What the last scan of an rc found; see libexec/rcblock.awk.
SCAN_START=0
SCAN_END=0
SCAN_FOREIGN=()
SCAN_ERRORS=()

# The old logger's block in OLD_RC, as find_legacy_block found it: its first and last line, 0 when
# there is none, and the sha256 of its exact bytes. SAVED_BLOCK is the private copy of those bytes.
LEGACY_FROM=0
LEGACY_TO=0
LEGACY_SHA=
SAVED_BLOCK=

# The sha256 of a dry run's OLD_RC, which is the live rc, as it was first read.
DRY_RUN_RC_SHA=

# The stale backup as check_stale_file found it: device, inode, size and mtime, which the move
# compares again, its mode, size and date for the plan, and where the move put it.
STALE_ID=
STALE_MODE=
STALE_SIZE=
STALE_DATE=
STALE_MOVED=

# What read_config found in the config: CONFIG_RECORDER is the recorder= value, unchecked, and
# CONFIG_RECORDER_LINE its line number, 0 when there is none. CONFIG_ENGAGEMENT and
# CONFIG_LOGDIR_MOUNT are empty for none. CONFIG_ENGAGEMENT_BAD is 1 when the only error in the
# config is an invalid engagement, which tlogger engagement may replace.
CONFIG_MODE=
CONFIG_LOGDIR=
CONFIG_ENGAGEMENT=
CONFIG_LOGDIR_MOUNT=
CONFIG_ENGAGEMENT_BAD=0
CONFIG_RECORDER=
CONFIG_RECORDER_LINE=0
CONFIG_ERROR=

# The recorder that auto mode runs, set by resolve_recorder, and the smoke test's temp folder
# while it exists.
RECORDER=
SMOKE_DIR=

# The session that render, show, replay, seal and verify work on, set by resolve_session: its
# folder, an absolute path, and its id, the folder's name. LOGDIR is the log folder, set by
# resolve_logdir, ENGAGEMENT_DIRS its engagement folders, set by find_engagement_dirs, and
# SESSIONS the session folders of both, set by list_sessions.
SESSION_DIR=
SESSION_ID=
LOGDIR=
ENGAGEMENT_DIRS=()
SESSIONS=()

# The files a seal covers, in the order SHA256SUMS lists them: the logs that script writes, the
# journal and the markers the plugin writes. A session holds the ones it has. Beside them a
# session folder may hold only what render and seal write, and their temp files.
SEAL_FILES=(output.raw timing input.raw commands.tsv recorder started exited stop-requested)
SEAL_EXTRAS_RE='^(transcript\.txt(\.part)?|(SHA256SUMS|SEAL)(\.part\.[A-Za-z0-9]{6})?)$'

# Set by recorder_state: yes while the recorder of a session still runs, no once it has gone,
# unknown without a recorder file. Set by seal_session: SEAL_RESULT, sealed, completed (a
# missing MANIFEST line added), already, live, mismatch or refused, SEAL_SUM, the SHA-256 of
# SHA256SUMS, and WHY, the reason of a refusal; by manifest_add: MANIFEST_ADDED, 1 when it
# appended. Set by verify_session: VERDICT, ok, changed, unsealed, recording or unknown. Set by
# parse_session_args: ARG_SESSION, the SESSION argument, and ARG_ALL, 1 for --all.
LIVE=
MANIFEST_ADDED=0
ARG_SESSION=
ARG_ALL=0
SEAL_RESULT=
SEAL_SUM=
WHY=
VERDICT=

# What doctor found. read_mountinfo fills MI_POINT, MI_TYPE, MI_DEV and MI_SOURCE, one entry per
# row of mountinfo; mount_row_of sets ROW, a row or -1; doctor_place sets PLACE_REAL, PLACE_ROW,
# PLACE_AUTOFS and PLACE_NET for a folder; doctor_volume sets MOUNT_OK; walk_device fills
# WALK_CRYPT, WALK_LAYERS, WALK_PLAIN and WALK_OTHER; doctor_line counts DOCTOR_WARN and
# DOCTOR_UNKNOWN.
MI_POINT=()
MI_TYPE=()
MI_DEV=()
MI_SOURCE=()
ROW=-1
PLACE_REAL=
PLACE_ROW=-1
PLACE_AUTOFS=0
PLACE_NET=0
MOUNT_OK=0
WALK_CRYPT=()
WALK_LAYERS=()
WALK_PLAIN=()
WALK_OTHER=()
declare -i DOCTOR_WARN=0 DOCTOR_UNKNOWN=0

# The interpreter that runs libexec/tlogger_view.py, set by require_python, and the scriptreplay
# that replay runs, set by require_scriptreplay.
PYTHON=
SCRIPTREPLAY=

# The terminal settings, as stty -g prints them, that replay changes while scriptreplay runs;
# restore_tty puts them back, and so does cleanup.
TTY_SAVED=

# Temp state that cleanup removes: the private work folder, which a dry run never creates, single
# temp files and links, a backup being written, and a release folder being built or replaced,
# removed through its MANIFEST. ASIDE_RELEASE is an old release that place_release has moved
# aside from ASIDE_DEST; cleanup moves it back when the swap stops halfway.
WORK=
TEMP_PATHS=()
PENDING_BACKUP=
DOOMED_RELEASE=
ASIDE_RELEASE=
ASIDE_DEST=

# =======================================================
#                        MESSAGES
# =======================================================

# Print MESSAGE on stderr after the 'tlogger: ' prefix.
# Callers pass every path through shown, so that no message names the home folder.
msg() {
    printf 'tlogger: %s\n' "$*" >&2
}

# Print MESSAGE on stderr as a warning; the run goes on.
warn() {
    printf 'tlogger: warning: %s\n' "$*" >&2
}

# Print MESSAGE on stderr and exit with STATUS. Never returns.
# Exits only the shell it runs in, so call it outside $(...) and pipelines.
die() {
    local status=$1
    shift
    printf 'tlogger: %s\n' "$*" >&2
    exit "$status"
}

# Print PATH with a leading $HOME replaced by ~, the form every message, plan and report uses.
# A home path usually names the user, so nothing tlogger prints shows it in full. HOME counts
# without its trailing slashes; a HOME of / replaces nothing.
shown() {
    local p=$1 home=${HOME-}
    while [[ $home == */ && $home != / ]]; do
        home=${home%/}
    done
    if [[ -n $home && $home != / && ( $p == "$home" || $p == "$home"/* ) ]]; then
        printf '~%s\n' "${p#"$home"}"
    else
        printf '%s\n' "$p"
    fi
}

# Print PATH without trailing slashes; / stays /.
# Pure string work: it never looks at the file system.
strip_slashes() {
    local p=$1
    while [[ $p == */ && $p != / ]]; do
        p=${p%/}
    done
    printf '%s\n' "$p"
}

# =======================================================
#                     USAGE AND CLEANUP
# =======================================================

# Print the usage text on stdout.
# The caller picks the stream and the exit status.
usage() {
    cat << 'EOF'
Usage: tlogger <command> [options]

Commands:
  install    Put the tlogger block at the top of the zsh rc (${ZDOTDIR-~}/.zshrc) and install
             the plugin files, the config and the state folders.
  uninstall  Remove the block and the plugin files. The config stays unless --purge-config is
             given; logs and rc backups always stay.
  mode       Print the mode in the config, auto or manual. tlogger mode auto|manual sets it;
             auto first runs a smoke test of the recorder.
  engagement [NAME | --none]
             Print the engagement in the config, or none. With NAME, new sessions go into
             the folder NAME in the log folder, with its own MANIFEST; --none clears it.
  status     Show whether tlogger is installed and where its files are.
  doctor     Check, and change nothing, that the log folder is private and lies on a mounted,
             encrypted volume that keeps Unix permissions.
  render     Write the plain-text transcript of a session to transcript.txt in its folder.
  show       Page the transcript of a session, rendered first when it is missing or older
             than the logs.
  replay     Replay a session in this terminal at its recorded pace, through a filter that
             drops the escape sequences a target could abuse.
  seal       Seal a session whose recording has ended: SHA256SUMS over its logs, the logs
             read-only, a SEAL file and a line in the MANIFEST of the folder that holds it. A
             recording that ends normally is sealed by itself.
  verify     Check that a sealed session is unchanged: its sums, its modes and its files.
  list       List the sessions of the log folder and its engagement folders with their state,
             start, duration, number of commands and engagement.
  version    Print the version.
  help       Show this help; -h and --help do the same.

In a zsh terminal with the plugin loaded, tlogger start records that terminal, tlogger stop
pauses the recording and tlogger status shows whether the terminal is recorded. In auto mode
every new terminal records itself as its shell starts.

render, show and replay take one SESSION: a session id, which names a folder in the log folder
or an engagement folder in it; a path to a session folder, which holds a /; or nothing, for the
newest session. output.raw with timing is the evidence; the transcript is derived from it and
holds no keystrokes typed at hidden prompts. render and show need python3 and python3-pyte,
replay python3 and scriptreplay.
  render --stdout      Print the transcript instead of writing transcript.txt.
  replay --speed N     Replay N times as fast; N is a positive number, such as 2 or 0.5.
  replay --maxdelay S  Wait at most S seconds between two outputs.
During a replay, Space pauses, Up and Down change the speed, Ctrl+C stops and Ctrl+Z suspends it.
seal and verify take one SESSION in the same way, or --all for every session of the log folder
or an engagement folder in it.
  verify               Print '<session>  ok', changed, unsealed or recording for each; keep the
                       SHA-256 that seal prints, or the MANIFEST, apart from the logs.

Install options:
  --mode auto|manual  Record every new terminal (auto) or only on request, with tlogger start
                      (manual). auto first runs a smoke test of the recorder.
                      Without --mode, the mode in the config is kept, or a terminal is asked.
  --dry-run           Show the plan and the change to the rc, and write nothing.
  --print-only        Print the block to add by hand, and write nothing.
  --yes               Do not ask for confirmation; needed outside a terminal.

Moving from an older logger, with install:
  --remove-block START END  Remove the lines from START to END, two whole lines of the rc given
                      exactly, in quotes. The bytes are saved first, in the quarantine folder.
  --block-sha256 HASH Go on only if that block is the one the dry run showed. --yes needs it,
                      outside a dry run.
  --quarantine FILE   Move the older logger's stale backup into the quarantine folder,
                      ~/.local/state/tlogger/quarantine, with mode 0600.
--remove-block and --quarantine also work alone. --print-only takes none of the three.

Uninstall options:
  --dry-run           Show the change to the rc and the files to remove, and write nothing.
  --yes               Do not ask for confirmation; needed outside a terminal.
  --purge-config      Remove the config as well.

Exit status: 0 done or nothing to change; 1 error or refusal (status: installed only in part;
verify: a session changed; doctor: a warning, or a check it could not decide); 2 usage error, or
--mode or --yes missing outside a terminal; 3 not installed, nothing to remove or no session to
view; 4 verify: a finished session is not sealed.
EOF
}

# Print MESSAGE and the usage text on stderr, then exit 2. Never returns.
usage_error() {
    printf 'tlogger: %s\n' "$*" >&2
    usage >&2
    exit 2
}

# Remove what this run made and did not keep: the work folder, the smoke test's folder, temp
# files and links, a partial backup and a release folder being built or replaced, after moving a
# release that was set aside back into place; and put back the terminal settings that replay
# changed. Runs from the EXIT trap, ignores every failure and never changes the exit status. It
# ignores HUP, INT, QUIT and TERM from its first line: bash ends an EXIT trap that a trapped
# signal interrupts, so a second Ctrl+C would otherwise leave temp files behind.
cleanup() {
    local p
    trap '' HUP INT QUIT TERM
    restore_tty
    remove_smoke_dir
    for p in "${TEMP_PATHS[@]}"; do
        rm -f -- "$p" 2> /dev/null || true
    done
    if [[ -n $PENDING_BACKUP ]]; then
        rm -f -- "$PENDING_BACKUP" 2> /dev/null || true
    fi
    if [[ -n $ASIDE_RELEASE && ! -e $ASIDE_DEST && ! -L $ASIDE_DEST ]]; then
        mv -T -- "$ASIDE_RELEASE" "$ASIDE_DEST" 2> /dev/null || true
    fi
    if [[ -n $DOOMED_RELEASE ]]; then
        remove_release_dir "$DOOMED_RELEASE" 2> /dev/null || true
    fi
    if [[ -n $WORK && -d $WORK ]]; then
        rm -f -- "$WORK"/* 2> /dev/null || true
        rmdir -- "$WORK" 2> /dev/null || true
    fi
}

# Set the traps that turn HUP, INT and TERM into an exit with status 128+n, so that the EXIT trap
# cleans up. main sets them; write_rc sets them again after a write that ignores those signals.
set_signal_traps() {
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

# Create the private work folder WORK under TMPDIR, where copies of the rc and the plans are built.
# mktemp makes it mode 0700; cleanup removes it with the plain files in it. A dry run never calls
# it, so that it writes nothing anywhere.
make_work() {
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/tlogger.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a temp folder in $(shown "${TMPDIR:-/tmp}")"
}

# =======================================================
#                     CHECKS AND PROMPTS
# =======================================================

# Succeed when stdin and stderr are both terminals, so that a question can be asked and answered.
on_tty() {
    [[ -t 0 && -t 2 ]]
}

# Ask QUESTION on the terminal and return when the answer is y or yes; --yes skips the question.
# Exits 1 on any other answer, which leaves everything as it was.
confirm() {
    local answer
    if (( OPT_YES )); then
        return 0
    fi
    printf 'tlogger: %s [y/N] ' "$1" >&2
    IFS= read -r answer || answer=
    case ${answer,,} in
        y | yes) return 0 ;;
    esac
    die 1 "nothing changed"
}

# Print the home folder of user 0 from the passwd database, or /root when getent cannot tell.
print_root_home() {
    local entry home=
    entry=$(getent passwd 0 2> /dev/null) || entry=
    IFS=: read -r _ _ _ _ _ home _ <<< "$entry" || true
    printf '%s\n' "${home:-/root}"
}

# Succeed when the path PATH is the folder DIR or lies under it, once readlink -m has made both
# canonical: every symlink that exists resolved and every . and .. part gone.
under_dir() {
    local path dir
    path=$(readlink -m -- "$1" 2> /dev/null) || return 1
    dir=$(readlink -m -- "$2" 2> /dev/null) || return 1
    [[ -n $path && -n $dir && ( $path == "$dir" || $path == "${dir%/}"/* ) ]]
}

# Exit 1 when running as root with a HOME that is not root's own: root must never write into
# another user's rc, config or evidence, as 'sudo tlogger' with a kept HOME would. A ZDOTDIR
# from the environment must lie in root's home too, since the zsh query runs the .zshenv there.
refuse_foreign_root() {
    local root_home
    if (( EUID != 0 )); then
        return 0
    fi
    root_home=$(print_root_home)
    if [[ $(strip_slashes "${HOME-}") != "$(strip_slashes "$root_home")" ]]; then
        die 1 "refusing to run as root for a home folder that is not root's; run tlogger as that user, without sudo"
    fi
    if [[ -n ${ZDOTDIR+set} ]] && ! under_dir "$ZDOTDIR" "$root_home"; then
        die 1 "refusing to run as root with a ZDOTDIR outside root's home; unset it, or run tlogger as the user it belongs to"
    fi
}

# Exit 1 when running as root and the zsh start-up folder or an XDG base folder that zsh reports
# lies outside root's home: root's rc would then source a plugin that another user can replace.
# Called by resolve_paths once the paths are known.
refuse_foreign_root_paths() {
    local root_home path
    if (( EUID != 0 )); then
        return 0
    fi
    root_home=$(print_root_home)
    for path in "$ZDOT" "$DATA_HOME" "$CONFIG_HOME" "$STATE_HOME"; do
        if ! under_dir "$path" "$root_home"; then
            die 1 "refusing to run as root with $(shown "$path") outside root's home; unset the ZDOTDIR or XDG variable that points there, or run tlogger as the user it belongs to"
        fi
    done
}

# Set VERSION_STR from the first line of the source tree's VERSION file.
# Exits 1 when the file is missing or that line is not a version.
read_version() {
    VERSION_STR=
    if [[ -f $SRC_ROOT/VERSION && -r $SRC_ROOT/VERSION ]]; then
        { IFS= read -r VERSION_STR < "$SRC_ROOT/VERSION"; } 2> /dev/null || true
    fi
    if [[ ! $VERSION_STR =~ $VERSION_RE ]]; then
        die 1 "cannot read a version from $(shown "$SRC_ROOT/VERSION")"
    fi
}

# Exit 1 when the source tree is an unpacked release whose manifest, terminal-logger-release.json,
# names another version than its VERSION: such a tree was mixed or edited, and would install under
# a wrong name. A tree without the manifest, such as a checkout, passes. Needs VERSION_STR.
check_release_manifest() {
    local f=$SRC_ROOT/terminal-logger-release.json line named=''
    if [[ ! -e $f && ! -L $f ]]; then
        return 0
    fi
    if [[ ! -f $f || ! -r $f ]]; then
        die 1 "cannot read the release manifest $(shown "$f"); unpack the release again"
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^[[:space:]]*\"version\":[[:space:]]*\"([0-9A-Za-z.+-]{1,40})\",?[[:space:]]*$ ]]; then
            named=${BASH_REMATCH[1]}
            break
        fi
    done < "$f"
    if [[ $named != "$VERSION_STR" ]]; then
        die 1 "the release manifest $(shown "$f") names version ${named:-none}, but VERSION is $VERSION_STR; unpack the release again"
    fi
}

# Exit 1 unless the source tree holds every release file, readable.
check_source_tree() {
    local f
    for f in "${RELEASE_FILES[@]}"; do
        if [[ ! -f $SRC_ROOT/$f || ! -r $SRC_ROOT/$f ]]; then
            die 1 "the source tree $(shown "$SRC_ROOT") lacks $f"
        fi
    done
}

# Warn when /usr/bin/script lacks --logging-format, which tlogger start needs (util-linux 2.35 or
# newer). Only warns: install works without it, and tlogger start refuses until it is there.
check_recorder() {
    local help
    help=$(/usr/bin/script --help 2> /dev/null) || help=
    if [[ $help != *--logging-format* ]]; then
        warn "/usr/bin/script lacks --logging-format; tlogger start needs util-linux 2.35 or newer"
    fi
}

# =======================================================
#                          PATHS
# =======================================================

# Ask zsh, with the user's .zshenv applied, for ZDOTDIR and the XDG base folders, and set every
# path global from the answer. Exits 1 when zsh is missing, gives no answer within 10 seconds,
# reports no value for a key, or reports one that is not an absolute path without a newline.
# The query's stderr is dropped, since start-up file errors name the home folder in full.
resolve_paths() {
    local out line key value status=0
    local -A found=()
    if [[ -z ${HOME:-} || $HOME != /* ]]; then
        die 1 "HOME is not set to an absolute path"
    fi
    if ! command -v zsh > /dev/null 2>&1; then
        die 1 "zsh is not installed, and tlogger works only with zsh; install it first"
    fi
    # TERM ends a non-interactive zsh; -k 2 follows with KILL when .zshenv traps TERM.
    out=$(timeout -k 2 10 zsh -c "$ZSH_PATH_QUERY" < /dev/null 2> /dev/null) || status=$?
    if (( status == 124 || status == 137 )); then
        die 1 "zsh did not answer within 10 seconds; check the zsh start-up files, such as .zshenv"
    fi
    while IFS= read -r line; do
        if [[ $line != TLOGGER_Q:*=* ]]; then
            continue
        fi
        line=${line#TLOGGER_Q:}
        case ${line%%=*} in
            ZDOTDIR | XDG_DATA_HOME | XDG_CONFIG_HOME | XDG_STATE_HOME)
                found[${line%%=*}]=${line#*=}
                ;;
        esac
    done <<< "$out"
    for key in ZDOTDIR XDG_DATA_HOME XDG_CONFIG_HOME XDG_STATE_HOME; do
        if [[ -z ${found[$key]+set} ]]; then
            die 1 "zsh reported no $key (exit status $status); check the zsh start-up files, such as .zshenv"
        fi
        value=${found[$key]}
        if [[ $value != /* ]]; then
            die 1 "zsh reports $key as a value that is not an absolute path without a newline"
        fi
        found[$key]=$(strip_slashes "$value")
    done
    ZDOT=${found[ZDOTDIR]}
    DATA_HOME=${found[XDG_DATA_HOME]}
    CONFIG_HOME=${found[XDG_CONFIG_HOME]}
    STATE_HOME=${found[XDG_STATE_HOME]}
    RC=$ZDOT/.zshrc
    DATA_DIR=$DATA_HOME/tlogger
    RELEASES_DIR=$DATA_DIR/releases
    CURRENT_LINK=$DATA_DIR/current
    PLUGIN=$CURRENT_LINK/lib/tlogger.zsh
    CONFIG_DIR=$CONFIG_HOME/tlogger
    CONFIG_FILE=$CONFIG_DIR/config
    STATE_DIR=$STATE_HOME/tlogger
    BACKUP_DIR=$STATE_DIR/rc-backups
    QUARANTINE_DIR=$STATE_DIR/quarantine
    SESSIONS_DIR=$STATE_DIR/sessions
    refuse_foreign_root_paths
}

# Set BLOCK to the 4 lines install puts at the top of the rc, each ending in LF. The plugin path
# is written as $HOME/... when it lies under HOME, else in full. Exits 1 when the part written
# literally holds a character that zsh treats specially inside double quotes.
build_block() {
    local home written literal
    home=$(strip_slashes "$HOME")
    if [[ $home != / && $PLUGIN == "$home"/* ]]; then
        literal=${PLUGIN#"$home"}
        written="\$HOME$literal"
    else
        literal=$PLUGIN
        written=$PLUGIN
    fi
    case $literal in
        *[\"\$\`\\]* | *$'\n'*)
            die 1 "the plugin path $(shown "$PLUGIN") holds a double quote, dollar sign, backquote, backslash or newline, which tlogger cannot write into the rc safely"
            ;;
    esac
    printf -v BLOCK '%s\n' "$START_MARK" \
        '# Managed by tlogger; remove it with tlogger uninstall.' \
        "if [[ -r \"$written\" ]]; then source \"$written\"; elif [[ -o interactive ]]; then print -u2 \"tlogger: plugin missing, this terminal is NOT recorded\"; fi" \
        "$END_MARK"
}

# =======================================================
#                          THE RC
# =======================================================

# Set RC_STATE to regular, missing or foreign (a symlink, a non-regular file, another user's file
# or one without write permission, which marks it as not to be edited) and RC_WHY to why a
# foreign rc is foreign. Looks at the rc without reading it.
classify_rc() {
    RC_WHY=
    if [[ -L $RC ]]; then
        RC_STATE=foreign RC_WHY="is a symlink"
    elif [[ ! -e $RC ]]; then
        RC_STATE=missing
    elif [[ ! -f $RC ]]; then
        RC_STATE=foreign RC_WHY="is not a regular file"
    elif [[ ! -O $RC ]]; then
        RC_STATE=foreign RC_WHY="belongs to another user"
    elif [[ ! -w $RC ]]; then
        RC_STATE=foreign RC_WHY="is not writable"
    else
        RC_STATE=regular
    fi
}

# Set OLD_RC to a snapshot of the file SOURCE, so that every later step reads the same bytes: a
# copy in WORK, or SOURCE itself in a dry run, which writes nothing.
# Exits 1 when SOURCE cannot be read or copied.
snapshot_rc() {
    local source=$1
    if [[ ! -r $source ]]; then
        die 1 "cannot read $(shown "$source")"
    fi
    if [[ -z $WORK ]]; then
        OLD_RC=$source
        return 0
    fi
    OLD_RC=$WORK/old-rc
    { cat -- "$source" > "$OLD_RC"; } 2> /dev/null ||
        die 1 "cannot copy $(shown "$source") to the temp folder"
}

# Take the snapshot of an existing rc and set SCANNED to the rc. A foreign rc counts only when it
# reads as a regular file, as the target of a symlink can; otherwise OLD_RC stays empty.
copy_rc() {
    OLD_RC=''
    SCANNED=$RC
    if [[ $RC_STATE == regular || ( $RC_STATE == foreign && -f $RC && -r $RC ) ]]; then
        snapshot_rc "$RC"
    fi
}

# Take the snapshot of what a missing rc starts from, ${TLOGGER_SKEL:-/etc/skel/.zshrc} when that
# is readable, else nothing (/dev/null), and set SEED and SCANNED to the file used. TLOGGER_SKEL
# exists for tests. Exits 1 when the zsh start-up folder itself is missing.
seed_rc() {
    local skel=${TLOGGER_SKEL:-/etc/skel/.zshrc}
    SEED=''
    SCANNED=$RC
    if [[ ! -d $ZDOT ]]; then
        die 1 "the zsh start-up folder $(shown "$ZDOT") does not exist"
    fi
    if [[ -f $skel && -r $skel ]]; then
        SEED=$skel SCANNED=$skel
        snapshot_rc "$skel"
    else
        snapshot_rc /dev/null
    fi
}

# Scan FILE with rcblock.awk into SCAN_START and SCAN_END (0 without a block), SCAN_FOREIGN (lines)
# and SCAN_ERRORS ('kind line'). Lines FROM to TO are about to be cut. Both are always passed, so
# the user's environment cannot hide a line. Exits 1 when the scan fails other than on bad markers.
scan_file() {
    local file=$1 from=${2:-} to=${3:-} name out line status=0
    name=$(shown "${SCANNED:-$RC}")
    SCAN_START=0 SCAN_END=0
    SCAN_FOREIGN=() SCAN_ERRORS=()
    out=$({ RCBLOCK_SKIP_FROM=$from RCBLOCK_SKIP_TO=$to LC_ALL=C \
        awk -f "$SRC_ROOT/libexec/rcblock.awk" < "$file"; } 2> /dev/null) || status=$?
    while IFS= read -r line; do
        case $line in
            '' | none) ;;
            'block '*) read -r _ SCAN_START SCAN_END <<< "$line" ;;
            'foreign '*) SCAN_FOREIGN+=("${line#foreign }") ;;
            'error '*) SCAN_ERRORS+=("${line#error }") ;;
            *) die 1 "rcblock.awk printed an unexpected line for $name" ;;
        esac
    done <<< "$out"
    if [[ ! $SCAN_START =~ ^[0-9]+$ || ! $SCAN_END =~ ^[0-9]+$ ]]; then
        die 1 "rcblock.awk printed an unexpected block line for $name"
    fi
    if (( status != 0 && ${#SCAN_ERRORS[@]} == 0 )); then
        die 1 "cannot scan $name (awk exit status $status)"
    fi
}

# Exit 1 when the last scan found malformed markers, naming each problem and its line number.
# The rc stays as it is: only a person can tell which marker lines are meant.
refuse_bad_markers() {
    local item kind what
    if (( ${#SCAN_ERRORS[@]} == 0 )); then
        return 0
    fi
    msg "$(shown "${SCANNED:-$RC}") holds malformed tlogger markers:"
    for item in "${SCAN_ERRORS[@]}"; do
        kind=${item% *}
        case $kind in
            unpaired) what="a marker without its partner" ;;
            duplicate) what="a marker that appears more than once" ;;
            reversed) what="the end marker comes before the start marker" ;;
            altered) what="a marker line with changed or extra text" ;;
            *) what="a marker problem" ;;
        esac
        msg "  line ${item##* }: $kind, $what"
    done
    die 1 "fix or remove those lines by hand, then run tlogger again; nothing changed"
}

# Exit 1 when a line outside the block runs util-linux script, the sign of another session
# recorder: two recorders in one rc would wrap every terminal twice.
refuse_foreign_recorder() {
    local count=${#SCAN_FOREIGN[@]} lines name
    if (( count == 0 )); then
        return 0
    fi
    lines=${SCAN_FOREIGN[*]}
    name=$(shown "${SCANNED:-$RC}")
    if (( count == 1 )); then
        die 1 "another session recorder appears to be set up in $name at line $lines; remove it first"
    fi
    die 1 "another session recorder appears to be set up in $name at lines ${lines// /, }; remove it first"
}

# Print lines FROM to TO of FILE, byte for byte; nothing when FROM is past TO. head comes first in
# the pipe, because a head after tail would die of SIGPIPE, which pipefail turns into a failure.
emit_lines() {
    local file=$1 from=$2 to=$3
    if (( from > to )); then
        return 0
    fi
    head -n "$to" -- "$file" | tail -n "+$from"
}

# Print the rc built from SOURCE for ACTION, using its last scan: put adds the block first or swaps
# it in place, strip cuts it out. Lines LEGACY_FROM to LEGACY_TO, if any, stay out. head and tail
# copy every other byte, CR bytes and a missing final newline included.
emit_rc() {
    local action=$1 source=$2 next=1
    if (( SCAN_START == 0 )) && [[ $action == put ]]; then
        printf '%s' "$BLOCK" || return 1
    fi
    if (( LEGACY_FROM && ( SCAN_START == 0 || LEGACY_FROM < SCAN_START ) )); then
        emit_lines "$source" 1 "$(( LEGACY_FROM - 1 ))" || return 1
        next=$(( LEGACY_TO + 1 ))
    fi
    if (( SCAN_START )); then
        emit_lines "$source" "$next" "$(( SCAN_START - 1 ))" || return 1
        if [[ $action == put ]]; then
            printf '%s' "$BLOCK" || return 1
        fi
        next=$(( SCAN_END + 1 ))
        if (( LEGACY_FROM > SCAN_START )); then
            emit_lines "$source" "$next" "$(( LEGACY_FROM - 1 ))" || return 1
            next=$(( LEGACY_TO + 1 ))
        fi
    fi
    tail -n "+$next" -- "$source" || return 1
}

# Write the rc built from OLD_RC for ACTION (put or strip) to WORK/new-rc, the file write_rc
# installs. Exits 1 when it cannot be written. A dry run never calls it.
build_rc() {
    { emit_rc "$1" "$OLD_RC" > "$WORK/new-rc"; } 2> /dev/null ||
        die 1 "cannot build the new rc in the temp folder"
}

# Run COMMAND with its arguments and the rc built from OLD_RC for ACTION on stdin: WORK/new-rc
# after build_rc, or straight from emit_rc in a dry run, which keeps no copy. Returns the status
# of COMMAND, or of emit_rc when that fails and COMMAND does not.
with_new_rc() {
    local action=$1
    shift
    if [[ -n $WORK ]]; then
        "$@" < "$WORK/new-rc"
    else
        emit_rc "$action" "$OLD_RC" 2> /dev/null | "$@"
    fi
}

# Succeed when the rc built from OLD_RC for ACTION differs from OLD_RC by any byte, or when the
# two cannot be compared. cmp's errors name the full path, so they are dropped.
new_rc_differs() {
    ! with_new_rc "$1" cmp -s -- "$OLD_RC" - 2> /dev/null
}

# Check that the rc built for ACTION parses wherever OLD_RC does: exit 1 when OLD_RC passes
# zsh -n and the new rc fails. When OLD_RC already fails, warn and go on.
check_syntax() {
    if zsh -n -f -- "$OLD_RC" > /dev/null 2>&1; then
        if ! with_new_rc "$1" zsh -n -f -- /dev/stdin > /dev/null 2>&1; then
            die 1 "the new rc would fail a zsh -n syntax check that the current one passes; nothing changed"
        fi
    else
        warn "$(shown "$RC") already fails a zsh -n syntax check; tlogger leaves the rest of it as it is"
    fi
}

# Print on stdout a unified diff from OLD_RC to the rc built for ACTION, labelled OLD_LABEL and
# NEW_LABEL, which callers give in the ~ form. Exits 1 when diff itself fails.
show_diff() {
    with_new_rc "$1" diff -u --label "$2" --label "$3" -- "$OLD_RC" - 2> /dev/null ||
        [[ $? -eq 1 ]] || die 1 "cannot compare the current and the new rc"
}

# Print how to add the block by hand to a foreign rc, which tlogger never edits, with the block
# itself on stdout. Uses the last scan of the rc for the lines of an outdated block.
print_by_hand() {
    msg "$(shown "$RC") $RC_WHY, so tlogger does not edit it."
    if (( SCAN_START )); then
        msg "Replace lines $SCAN_START-$SCAN_END of the file (for a symlink, the file it points to) with these 4 lines,"
    else
        msg "Add these 4 lines at the very top of the file (for a symlink, the file it points to),"
    fi
    msg "then run tlogger install again; with the block in place it sets up the rest without editing the file."
    printf '%s' "$BLOCK"
}

# =======================================================
#                 MOVING FROM AN OLDER LOGGER
# =======================================================

# Print PATH as shown prints it, quoted so that it can be pasted into a shell. The ~ stays outside
# the quoting, where the shell expands it.
shown_arg() {
    local p
    p=$(shown "$1")
    # shellcheck disable=SC2088 # The ~ is text here, printed for the shell that pastes it.
    if [[ $p == '~/'* ]]; then
        printf '~/%q\n' "${p#'~/'}"
    else
        printf '%q\n' "$p"
    fi
}

# Print on stderr the command that moves the stale backup later, when --quarantine was given. It
# names this copy of tlogger: nothing is installed yet, and an older release lacks the option.
note_quarantine_followup() {
    if (( OPT_QUARANTINE_SET )); then
        msg "the stale backup was not moved; afterwards, run: $(shown_arg "$SRC_ROOT/bin/tlogger") install --quarantine $(shown_arg "$OPT_QUARANTINE")"
    fi
}

# Print MESSAGE and the --quarantine follow-up on stderr, then exit 3: there is no old block.
refuse_no_block() {
    msg "$1"
    note_quarantine_followup
    exit 3
}

# Exit 3 for an rc that holds neither marker. Only an rc with tlogger's block gets the --quarantine
# command: without it the markers may be mistyped, and that command would add tlogger beside them.
refuse_no_markers() {
    msg "$(shown "$RC") holds neither marker line, so there is no old block to remove"
    scan_file "$OLD_RC"
    if (( SCAN_START )); then
        note_quarantine_followup
    elif (( OPT_QUARANTINE_SET )); then
        msg "the stale backup was not moved; check both marker lines against the rc, because an old block that stays would run beside tlogger"
    fi
    exit 3
}

# Set LEGACY_FROM, LEGACY_TO and LEGACY_SHA from the two given markers in OLD_RC, and check the
# fingerprint when one was given. Exits 3 when neither marker is there and 1 for any odd pairing
# or another block than the fingerprint names. Messages give line numbers, never the marker text.
find_legacy_block() {
    local out line item kind what status=0 sum
    local -a errors=()
    out=$({ LEGACY_START=$OPT_LEGACY_START LEGACY_END=$OPT_LEGACY_END LC_ALL=C \
        awk -f "$SRC_ROOT/libexec/legacyblock.awk" < "$OLD_RC"; } 2> /dev/null) || status=$?
    while IFS= read -r line; do
        case $line in
            '') ;;
            none) refuse_no_markers ;;
            'block '*) read -r _ LEGACY_FROM LEGACY_TO <<< "$line" ;;
            'error '*) errors+=("${line#error }") ;;
            *) die 1 "legacyblock.awk printed an unexpected line for $(shown "$RC")" ;;
        esac
    done <<< "$out"
    if (( ${#errors[@]} )); then
        msg "the old block's marker lines in $(shown "$RC") do not pair:"
        for item in "${errors[@]}"; do
            kind=${item% *}
            case $kind in
                unpaired) what="a marker without its partner" ;;
                duplicate) what="a marker that appears more than once" ;;
                reversed) what="the end marker comes before the start marker" ;;
                altered) what="a line that holds a marker with changed or extra text" ;;
                *) what="a marker problem" ;;
            esac
            msg "  line ${item##* }: $kind, $what"
        done
        die 1 "fix those lines or remove the block by hand, then run tlogger again; nothing changed"
    fi
    if (( status != 0 )) || [[ ! $LEGACY_FROM =~ ^[1-9][0-9]*$ || ! $LEGACY_TO =~ ^[1-9][0-9]*$ ]]; then
        die 1 "cannot scan $(shown "$RC") for the old block (awk exit status $status)"
    fi
    sum=$({ emit_lines "$OLD_RC" "$LEGACY_FROM" "$LEGACY_TO" | sha256sum; } 2> /dev/null) ||
        die 1 "cannot compute the fingerprint of the old block"
    LEGACY_SHA=${sum%% *}
    if (( OPT_BLOCK_SHA_SET )) && [[ ${OPT_BLOCK_SHA,,} != "$LEGACY_SHA" ]]; then
        die 1 "the old block at lines $LEGACY_FROM-$LEGACY_TO does not match the --block-sha256 fingerprint; look at it with --dry-run; nothing changed"
    fi
}

# Exit 1 unless a tlogger block found by the last scan lies wholly before or wholly after the old
# block, so that neither of the two is cut in half.
refuse_block_overlap() {
    if (( SCAN_START && SCAN_END >= LEGACY_FROM && SCAN_START <= LEGACY_TO )); then
        die 1 "the tlogger block at lines $SCAN_START-$SCAN_END overlaps the old block at lines $LEGACY_FROM-$LEGACY_TO; separate them by hand, then run tlogger again; nothing changed"
    fi
}

# Print the line the saved block goes back to once tlogger's lines are out of the rc: its own
# first line, less the size of a tlogger block above it.
legacy_return_line() {
    local line=$LEGACY_FROM
    if (( SCAN_START && SCAN_START < LEGACY_FROM )); then
        line=$(( line - ( SCAN_END - SCAN_START + 1 ) ))
    fi
    printf '%s\n' "$line"
}

# Succeed when the tlogger block found by the last scan already holds exactly BLOCK. The x keeps
# the command substitution from dropping the block's last newline.
own_block_current() {
    local current
    (( SCAN_START )) || return 1
    current=$(emit_lines "$OLD_RC" "$SCAN_START" "$SCAN_END" 2> /dev/null; printf x) || return 1
    [[ ${current%x} == "$BLOCK" ]]
}

# For a foreign rc holding the old block, which tlogger never edits: print the edits on stderr,
# highest lines first so that each number stays right while they are made, and the 4 lines of
# the block on stdout unless the rc already holds them.
print_cut_by_hand() {
    local cut="delete lines $LEGACY_FROM-$LEGACY_TO, the old block" put='' i=0 edit
    local -a edits=()
    if (( SCAN_START == 0 )); then
        put="add the 4 lines printed on stdout at the very top"
        edits=("$cut" "$put")
    elif own_block_current; then
        edits=("$cut")
    else
        put="replace lines $SCAN_START-$SCAN_END with the 4 lines printed on stdout"
        if (( SCAN_START > LEGACY_TO )); then
            edits=("$put" "$cut")
        else
            edits=("$cut" "$put")
        fi
    fi
    msg "$(shown "$RC") $RC_WHY, so tlogger does not edit it."
    msg "Make these edits in the file (for a symlink, the file it points to), in this order:"
    for edit in "${edits[@]}"; do
        i=$(( i + 1 ))
        msg "  $i. $edit"
    done
    msg "then run tlogger install again; with the old block gone and the tlogger block in place it sets up the rest without editing the file."
    if [[ -n $put ]]; then
        printf '%s' "$BLOCK"
    fi
}

# Save the old block's exact bytes as quarantine/removed-block.L<line>.<UTC>.<random>, mode 0600,
# and set SAVED_BLOCK. It stays in TEMP_PATHS until write_rc starts to write the rc, so that a run
# that stops earlier leaves no copy of a block that is still in the rc.
save_removed_block() {
    local stamp sum
    stamp=$(date -u +%Y%m%dT%H%M%SZ 2> /dev/null) || die 1 "cannot read the clock"
    SAVED_BLOCK=$(mktemp "$QUARANTINE_DIR/removed-block.L$(legacy_return_line).$stamp.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a file in $(shown "$QUARANTINE_DIR")"
    TEMP_PATHS+=("$SAVED_BLOCK")
    chmod 600 -- "$SAVED_BLOCK" 2> /dev/null ||
        die 1 "cannot set mode 0600 on $(shown "$SAVED_BLOCK")"
    { emit_lines "$OLD_RC" "$LEGACY_FROM" "$LEGACY_TO" > "$SAVED_BLOCK"; } 2> /dev/null ||
        die 1 "cannot save the old block in $(shown "$QUARANTINE_DIR")"
    sum=$({ sha256sum < "$SAVED_BLOCK"; } 2> /dev/null) || sum=
    if [[ ${sum%% *} != "$LEGACY_SHA" ]]; then
        die 1 "the saved copy of the old block does not match it; $(shown "$RC") was not written"
    fi
}

# Take PATH out of TEMP_PATHS, so that cleanup keeps it. An empty PATH does nothing.
forget_temp() {
    local p
    local -a kept=()
    for p in "${TEMP_PATHS[@]}"; do
        if [[ $p != "$1" ]]; then
            kept+=("$p")
        fi
    done
    TEMP_PATHS=("${kept[@]}")
}

# Print on stdout where the old block went and the commands that put it back. The full path works
# in a terminal without the plugin, and && keeps a failed uninstall from reaching the restore.
print_undo() {
    local n rc saved
    n=$(legacy_return_line)
    rc=$(shown_arg "$RC")
    saved=$(shown_arg "$SAVED_BLOCK")
    printf 'The old block is out of %s and saved in %s.\n' "$(shown "$RC")" "$(shown "$SAVED_BLOCK")"
    printf 'To put it back, paste these lines; if tlogger is already uninstalled, leave out the first:\n'
    printf '  %s uninstall &&\n' "$(shown_arg "$CURRENT_LINK/bin/tlogger")"
    printf '  ( umask 077\n'
    printf '    { head -n %s %s; cat %s; tail -n +%s %s; } > %s.undo &&\n' \
        "$(( n - 1 ))" "$rc" "$saved" "$n" "$rc" "$rc"
    printf '    cat %s.undo > %s && rm %s.undo )\n' "$rc" "$rc" "$rc"
}

# Print SIZE in bytes the way the plan shows it, such as 21 bytes or 2.1 KiB.
human_size() {
    local size=$1 tenths i=0
    local -a units=(KiB MiB GiB TiB)
    if (( size < 1024 )); then
        printf '%s bytes\n' "$size"
        return 0
    fi
    tenths=$(( size * 10 / 1024 ))
    while (( tenths >= 10240 && i < 3 )); do
        tenths=$(( tenths / 1024 ))
        i=$(( i + 1 ))
    done
    printf '%s.%s %s\n' "$(( tenths / 10 ))" "$(( tenths % 10 ))" "${units[i]}"
}

# Exit 1 with REASON for the file --quarantine names.
refuse_stale() {
    die 1 "cannot quarantine $(shown "$OPT_QUARANTINE"): $1; nothing changed"
}

# Print the longest file name, in bytes, that the quarantine folder can hold, asking the nearest
# folder that exists. 255, the limit of the usual Linux file systems, when getconf cannot tell.
quarantine_name_max() {
    local dir=$QUARANTINE_DIR max
    while [[ ! -d $dir ]]; do
        dir=${dir%/*}
        dir=${dir:-/}
    done
    max=$(getconf NAME_MAX "$dir" 2> /dev/null) || max=255
    if [[ ! $max =~ ^[1-9][0-9]*$ ]]; then
        max=255
    fi
    printf '%s\n' "$max"
}

# Exit 1 unless the file --quarantine names can be moved safely: this user's readable regular file
# with one link, in a folder it can leave, in HOME or ZDOT, no start-up, tlogger or log file, and
# with a name that fits. Records what the move compares. Call after read_config (CONFIG_LOGDIR).
check_stale_file() {
    local file=$OPT_QUARANTINE real dir name target links info logdir parent bytes
    local -a own=("$DATA_DIR" "$SRC_ROOT" "$CONFIG_DIR" "$STATE_DIR" "$SESSIONS_DIR")
    if [[ $file == *[[:cntrl:]]* ]]; then
        die 1 "cannot quarantine the file: its path holds a control character; move it by hand; nothing changed"
    fi
    if [[ -L $file ]]; then
        refuse_stale "it is a symlink"
    fi
    if [[ ! -e $file ]]; then
        refuse_stale "it does not exist"
    fi
    if [[ ! -f $file ]]; then
        refuse_stale "it is not a regular file"
    fi
    if [[ ! -O $file ]]; then
        refuse_stale "it belongs to another user"
    fi
    if [[ ! -r $file ]]; then
        refuse_stale "it cannot be read"
    fi
    parent=${file%/*}
    if [[ ! -w ${parent:-/} || ! -x ${parent:-/} ]]; then
        refuse_stale "its folder does not let tlogger remove it"
    fi
    links=$(stat -c %h -- "$file" 2> /dev/null) || refuse_stale "tlogger cannot read its details"
    if (( links > 1 )); then
        refuse_stale "it has $links hard links, so another name would keep its content"
    fi
    real=$(readlink -f -- "$file" 2> /dev/null) || refuse_stale "tlogger cannot resolve its path"
    if ! under_dir "$real" "$HOME" && ! under_dir "$real" "$ZDOT"; then
        refuse_stale "it lies outside the home and zsh folders"
    fi
    for dir in "$ZDOT" "$HOME"; do
        for name in .zshenv .zprofile .zshrc .zlogin .zlogout; do
            target=$(readlink -f -- "$dir/$name" 2> /dev/null) || target=
            if [[ -n $target && $target == "$real" ]]; then
                refuse_stale "it is a zsh start-up file, or the real file behind one"
            fi
        done
    done
    if [[ -n $CONFIG_LOGDIR ]]; then
        own+=("$CONFIG_LOGDIR")
    fi
    # Trimmed as lib/config.zsh trims it, so that this is the folder the plugin records into.
    if [[ -n ${TLOGGER_LOGDIR-} && ${TLOGGER_LOGDIR@a} == *x* ]]; then
        logdir=$TLOGGER_LOGDIR
        logdir=${logdir#"${logdir%%[![:space:]]*}"}
        logdir=${logdir%"${logdir##*[![:space:]]}"}
        if [[ -n $logdir ]]; then
            own+=("$logdir")
        fi
    fi
    for dir in "${own[@]}"; do
        if under_dir "$real" "$dir"; then
            refuse_stale "it lies in one of tlogger's own code, config, state or log folders"
        fi
    done
    # The move adds .<UTC time>.<random>, 24 bytes, to the name.
    bytes=$(printf '%s' "${file##*/}" | wc -c)
    if (( bytes + 24 > $(quarantine_name_max) )); then
        refuse_stale "its file name is too long for the quarantine folder; rename it first"
    fi
    info=$(stat -c '%d:%i:%s:%.9Y %a %s %Y' -- "$file" 2> /dev/null) ||
        refuse_stale "tlogger cannot read its details"
    read -r STALE_ID STALE_MODE STALE_SIZE name <<< "$info"
    STALE_DATE=$(date -u -d "@$name" +%F 2> /dev/null) || STALE_DATE=unknown
}

# Exit 1 for a move that failed with REASON, naming the command that finishes the job. The code is
# installed by now, and the plugin's tlogger command may not exist in this terminal.
die_move() {
    die 1 "$(shown "$OPT_QUARANTINE") was not moved: $1; to finish, run: $(shown_arg "$CURRENT_LINK/bin/tlogger") install --quarantine $(shown_arg "$OPT_QUARANTINE")"
}

# Move the stale backup to quarantine/<name>.<UTC>.<random>, mode 0600, keeping its mtime. The copy
# is finished, compared and renamed before the source goes, so a stop leaves two copies at worst.
# Sets STALE_MOVED.
move_stale() {
    local file=$OPT_QUARANTINE stamp tmp final
    stamp=$(date -u +%Y%m%dT%H%M%SZ 2> /dev/null) || die_move "cannot read the clock"
    tmp=$(mktemp "$QUARANTINE_DIR/.moving.XXXXXX" 2> /dev/null) ||
        die_move "cannot create a file in $(shown "$QUARANTINE_DIR")"
    TEMP_PATHS+=("$tmp")
    chmod 600 -- "$tmp" 2> /dev/null || die_move "cannot set mode 0600 on the copy"
    { cat -- "$file" > "$tmp"; } 2> /dev/null || die_move "cannot copy it"
    touch -r "$file" -- "$tmp" 2> /dev/null || die_move "cannot keep its timestamp"
    cmp -s -- "$file" "$tmp" 2> /dev/null || die_move "the copy differs from it"
    if [[ $(stat -c '%d:%i:%s:%.9Y' -- "$file" 2> /dev/null) != "$STALE_ID" ]]; then
        die_move "it changed while tlogger was copying it"
    fi
    final=$(mktemp "$QUARANTINE_DIR/${file##*/}.$stamp.XXXXXX" 2> /dev/null) ||
        die_move "cannot create a file in $(shown "$QUARANTINE_DIR")"
    TEMP_PATHS+=("$final")
    mv -T -f -- "$tmp" "$final" 2> /dev/null || die_move "cannot rename the copy"
    forget_temp "$tmp"
    forget_temp "$final"
    STALE_MOVED=$final
    rm -f -- "$file" 2> /dev/null || true
    # Running the move again would only add another copy, so this asks for the one step left.
    if [[ -e $file || -L $file ]]; then
        die 1 "$(shown "$file") is copied to $(shown "$final"), but the original cannot be deleted; delete it by hand"
    fi
}

# Copy the rc to rc-backups/zshrc.<UTC time>.<random> with mode 0600, and set BACKUP to it. With
# PRUNE set to prune, keep the five newest backups; uninstall passes keep and deletes none.
backup_rc() {
    local prune=$1 stamp
    stamp=$(date -u +%Y%m%dT%H%M%SZ 2> /dev/null) || die 1 "cannot read the clock"
    PENDING_BACKUP=$(mktemp "$BACKUP_DIR/zshrc.$stamp.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a backup in $(shown "$BACKUP_DIR")"
    chmod 600 -- "$PENDING_BACKUP" 2> /dev/null ||
        die 1 "cannot set mode 0600 on $(shown "$PENDING_BACKUP")"
    { cat -- "$RC" > "$PENDING_BACKUP"; } 2> /dev/null || die 1 "cannot back up $(shown "$RC")"
    BACKUP=$PENDING_BACKUP
    PENDING_BACKUP=
    if [[ $prune == prune ]]; then
        prune_backups
    fi
}

# Delete all but the four newest backups other than BACKUP, so that five remain. Counts only
# regular files named as backup_rc names them (BACKUP_NAME_RE); symlinks and every other file
# stay. The UTC time in the name orders them to the second: backups made within one second keep
# no order among themselves.
prune_backups() {
    local f excess
    local -a old=()
    while IFS= read -r f; do
        old+=("$f")
    done < <(
        for f in "$BACKUP_DIR"/zshrc.*; do
            if [[ -f $f && ! -L $f && $f != "$BACKUP" && ${f##*/} =~ $BACKUP_NAME_RE ]]; then
                printf '%s\n' "$f"
            fi
        done | LC_ALL=C sort
    )
    excess=$(( ${#old[@]} - 4 ))
    if (( excess <= 0 )); then
        return 0
    fi
    for f in "${old[@]:0:excess}"; do
        rm -f -- "$f" 2> /dev/null || warn "cannot delete the old backup $(shown "$f")"
    done
}

# Replace the rc with the file NEW after a backup (PRUNE as for backup_rc; keep means uninstall).
# Keeps the mode and a hard-linked rc's inode; a missing rc is created with mode 0644. Exits 1 when
# the rc changed since it was read or lacks NEW afterwards. The first write keeps SAVED_BLOCK.
write_rc() {
    local new=$1 prune=$2 tmp links left="the code and config may already be updated"
    if [[ $prune == keep ]]; then
        left="nothing was removed"
    fi
    if [[ $RC_STATE == missing ]]; then
        tmp=$(mktemp "$ZDOT/.zshrc.tlogger.XXXXXX" 2> /dev/null) ||
            die 1 "cannot create a temp file in $(shown "$ZDOT")"
        TEMP_PATHS+=("$tmp")
        { cat -- "$new" > "$tmp"; } 2> /dev/null || die 1 "cannot write a temp file in $(shown "$ZDOT")"
        chmod 644 -- "$tmp" 2> /dev/null || die 1 "cannot set mode 0644 on a temp file in $(shown "$ZDOT")"
        # link(2) fails when the name exists, so an rc made meanwhile is never overwritten. On a
        # file system without hard links, mv -n renames only while the name is still free.
        if ln -- "$tmp" "$RC" 2> /dev/null; then
            rm -f -- "$tmp" 2> /dev/null || true
        else
            if [[ ! -e $RC && ! -L $RC ]]; then
                mv -n -T -- "$tmp" "$RC" 2> /dev/null || true
            fi
            if [[ -e $tmp ]]; then
                die 1 "cannot create $(shown "$RC"), or it appeared while tlogger was working, so tlogger did not write it; $left; run the command again"
            fi
        fi
        check_written "$new"
        return 0
    fi
    if [[ -L $RC || ! -f $RC ]] || ! cmp -s -- "$OLD_RC" "$RC" 2> /dev/null; then
        die 1 "$(shown "$RC") changed while tlogger was working, so tlogger did not write it; $left; run the command again"
    fi
    backup_rc "$prune"
    links=$(stat -c %h -- "$RC" 2> /dev/null) || die 1 "cannot read the link count of $(shown "$RC")"
    if (( links > 1 )); then
        # A rename would split the hard links, so the bytes go into the same inode. HUP, INT, QUIT
        # and TERM are ignored meanwhile, so that no signal leaves the rc cut short.
        trap '' HUP INT QUIT TERM
        forget_temp "$SAVED_BLOCK"
        if ! { cat -- "$new" > "$RC"; } 2> /dev/null; then
            set_signal_traps
            trap - QUIT
            die 1 "cannot write $(shown "$RC"); the backup is $(shown "$BACKUP")"
        fi
        set_signal_traps
        trap - QUIT
        check_written "$new"
        return 0
    fi
    # The temp file sits in the rc's own folder, so that the rename is atomic.
    tmp=$(mktemp "$ZDOT/.zshrc.tlogger.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a temp file in $(shown "$ZDOT")"
    TEMP_PATHS+=("$tmp")
    { cat -- "$new" > "$tmp"; } 2> /dev/null || die 1 "cannot write a temp file in $(shown "$ZDOT")"
    chmod --reference="$RC" -- "$tmp" 2> /dev/null || die 1 "cannot copy the mode of $(shown "$RC")"
    forget_temp "$SAVED_BLOCK"
    mv -T -f -- "$tmp" "$RC" 2> /dev/null ||
        die 1 "cannot replace $(shown "$RC"); the backup is $(shown "$BACKUP")"
    check_written "$new"
}

# Exit 1 unless the rc now holds exactly the bytes of the file NEW, naming the backup to restore
# from when there is one. Called by write_rc after each write.
check_written() {
    if cmp -s -- "$1" "$RC" 2> /dev/null; then
        return 0
    fi
    if [[ -n $BACKUP ]]; then
        die 1 "$(shown "$RC") does not hold what tlogger wrote; restore it from $(shown "$BACKUP")"
    fi
    die 1 "$(shown "$RC") does not hold what tlogger wrote; check it by hand"
}

# =======================================================
#                         THE CODE
# =======================================================

# Write the MANIFEST of the source tree to WORK: one sha256sum line per release file.
# Exits 1 when a source file cannot be read. A dry run never calls it.
make_manifest() {
    { (cd -- "$SRC_ROOT" && sha256sum -- "${RELEASE_FILES[@]}") > "$WORK/MANIFEST"; } 2> /dev/null ||
        die 1 "cannot read the files of the source tree $(shown "$SRC_ROOT")"
}

# Succeed when the folder DEST already holds this source tree's release: a real folder whose
# MANIFEST equals the one in WORK, whose files still match it and whose bin/tlogger runs.
release_matches() {
    local dest=$1
    [[ -d $dest && ! -L $dest && -f $dest/MANIFEST && ! -L $dest/MANIFEST ]] || return 1
    [[ -x $dest/bin/tlogger ]] || return 1
    cmp -s -- "$WORK/MANIFEST" "$dest/MANIFEST" || return 1
    (cd -- "$dest" && sha256sum --quiet --check MANIFEST) > /dev/null 2>&1
}

# Print the name of the release the current link points at, or nothing when there is no link
# or it points anywhere other than releases/<name>.
current_release() {
    local target
    [[ -L $CURRENT_LINK ]] || return 0
    target=$(readlink -- "$CURRENT_LINK" 2> /dev/null) || return 0
    if [[ $target == releases/* && ${target#releases/} != */* ]]; then
        printf '%s\n' "${target#releases/}"
    fi
}

# Succeed when the version A ranks above the version B, both of the VERSION_RE form. X.Y.Z
# compare number by number; at equal numbers a version with a suffix ranks below the one without,
# as 0.1.0-dev below 0.1.0, and two suffixes compare as sort -V orders them.
version_newer() {
    local a=$1 b=$2 top
    if [[ $a == "$b" ]]; then
        return 1
    fi
    if [[ ${a%%-*} != "${b%%-*}" ]]; then
        top=$(printf '%s\n' "${a%%-*}" "${b%%-*}" | LC_ALL=C sort -V | tail -n 1)
        [[ $top == "${a%%-*}" ]]
        return
    fi
    if [[ $a != *-* ]]; then
        return 0
    fi
    if [[ $b != *-* ]]; then
        return 1
    fi
    top=$(printf '%s\n' "$a" "$b" | LC_ALL=C sort -V | tail -n 1)
    [[ $top == "$a" ]]
}

# Exit 1 when the current link points at a working release newer than this source tree. An older
# copy of tlogger, such as the bin/tlogger that a terminal opened before an upgrade still runs,
# would otherwise switch every new terminal back to old code.
refuse_downgrade() {
    local current
    current=$(current_release)
    if [[ $current =~ $VERSION_RE && -x $RELEASES_DIR/$current/bin/tlogger ]] &&
        version_newer "$current" "$VERSION_STR"; then
        die 1 "$(shown "$CURRENT_LINK") is $current, newer than this tlogger ($VERSION_STR); run $(shown "$CURRENT_LINK/bin/tlogger") install instead, or tlogger uninstall first to go back to $VERSION_STR on purpose"
    fi
}

# Build this source tree's release in a temp folder under releases/, set DOOMED_RELEASE to it
# and check the copies against the MANIFEST. The MANIFEST goes in first, so that cleanup can
# remove a half-built folder through it.
build_release() {
    local f mode
    DOOMED_RELEASE=$(mktemp -d "$RELEASES_DIR/.build.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a temp folder in $(shown "$RELEASES_DIR")"
    install -m 0644 -- "$WORK/MANIFEST" "$DOOMED_RELEASE/MANIFEST" 2> /dev/null ||
        die 1 "cannot write the MANIFEST in $(shown "$RELEASES_DIR")"
    for f in "${RELEASE_FILES[@]}"; do
        if [[ $f == */* ]]; then
            install -d -m 0755 -- "$DOOMED_RELEASE/${f%/*}" 2> /dev/null ||
                die 1 "cannot create a folder in $(shown "$RELEASES_DIR")"
        fi
        mode=0644
        if [[ $f == bin/tlogger ]]; then
            mode=0755
        fi
        install -m "$mode" -- "$SRC_ROOT/$f" "$DOOMED_RELEASE/$f" 2> /dev/null ||
            die 1 "cannot copy $f into $(shown "$RELEASES_DIR")"
    done
    if ! (cd -- "$DOOMED_RELEASE" && sha256sum --quiet --check MANIFEST) > /dev/null 2>&1; then
        die 1 "the copied files do not match their MANIFEST; nothing was switched"
    fi
    chmod 755 -- "$DOOMED_RELEASE" 2> /dev/null || die 1 "cannot set the mode of the new release folder"
}

# Move the release built in DOOMED_RELEASE to the folder DEST. An existing DEST, the same version
# with other content, is swapped out in one exchange where mv supports it, else by two renames,
# and then removed through its MANIFEST.
place_release() {
    local dest=$1 old
    if [[ ! -e $dest && ! -L $dest ]]; then
        mv -T -- "$DOOMED_RELEASE" "$dest" 2> /dev/null ||
            die 1 "cannot move the new release to $(shown "$dest")"
        DOOMED_RELEASE=
        return 0
    fi
    if [[ -L $dest || ! -d $dest ]]; then
        die 1 "$(shown "$dest") is not a release folder; remove it by hand"
    fi
    # With an mv that lacks --exchange, or a file system that cannot exchange, nothing moves.
    if ! mv --exchange -T -- "$DOOMED_RELEASE" "$dest" 2> /dev/null; then
        old=$RELEASES_DIR/.old.$$
        if [[ -e $old || -L $old ]]; then
            die 1 "$(shown "$old") is in the way; remove it by hand"
        fi
        # Between the two renames DEST is missing; cleanup then moves the old release back.
        ASIDE_RELEASE=$old ASIDE_DEST=$dest
        mv -T -- "$dest" "$old" 2> /dev/null || die 1 "cannot move the old release $(shown "$dest") aside"
        mv -T -- "$DOOMED_RELEASE" "$dest" 2> /dev/null ||
            die 1 "cannot move the new release to $(shown "$dest")"
        DOOMED_RELEASE=$old
        ASIDE_RELEASE='' ASIDE_DEST=''
    fi
    # DOOMED_RELEASE now names the old release.
    remove_release_dir "$DOOMED_RELEASE" || true
    DOOMED_RELEASE=
}

# Point the current link at releases/<version>: a relative symlink made under a temp name and
# renamed over the old link, so that a starting shell always finds one or the other.
switch_current() {
    local target=releases/$VERSION_STR tmp
    if [[ -e $CURRENT_LINK && ! -L $CURRENT_LINK ]]; then
        die 1 "$(shown "$CURRENT_LINK") is not a symlink; remove it by hand"
    fi
    if [[ -L $CURRENT_LINK && $(readlink -- "$CURRENT_LINK" 2> /dev/null) == "$target" ]]; then
        return 0
    fi
    tmp=$DATA_DIR/.current.$$
    TEMP_PATHS+=("$tmp")
    rm -f -- "$tmp" 2> /dev/null || true
    ln -s -- "$target" "$tmp" 2> /dev/null || die 1 "cannot create a symlink in $(shown "$DATA_DIR")"
    if [[ ! -L $tmp ]]; then
        die 1 "cannot create a symlink in $(shown "$DATA_DIR"); its file system may not support them"
    fi
    mv -T -f -- "$tmp" "$CURRENT_LINK" 2> /dev/null || die 1 "cannot switch $(shown "$CURRENT_LINK")"
}

# Keep the current release and one older one, the release current pointed at before (PREVIOUS)
# or else the highest other version by version_newer, and remove every other release folder
# through its MANIFEST.
prune_releases() {
    local previous=$1 dir name keep=
    local -a others=()
    for dir in "$RELEASES_DIR"/*; do
        name=${dir##*/}
        if [[ -d $dir && ! -L $dir && $name =~ $VERSION_RE && $name != "$VERSION_STR" ]]; then
            others+=("$name")
        fi
    done
    if (( ${#others[@]} == 0 )); then
        return 0
    fi
    for name in "${others[@]}"; do
        if [[ $name == "$previous" ]]; then
            keep=$name
        fi
    done
    if [[ -z $keep ]]; then
        for name in "${others[@]}"; do
            if [[ -z $keep ]] || version_newer "$name" "$keep"; then
                keep=$name
            fi
        done
    fi
    for name in "${others[@]}"; do
        if [[ $name != "$keep" ]]; then
            remove_release_dir "$RELEASES_DIR/$name" || true
        fi
    done
}

# Succeed when the path REL inside the folder DIR is a symlink or passes through one.
path_has_link() {
    local dir=$1 part='' name
    local -a names=()
    IFS=/ read -r -a names <<< "$2"
    for name in "${names[@]}"; do
        part=${part:+$part/}$name
        if [[ -L $dir/$part ]]; then
            return 0
        fi
    done
    return 1
}

# Remove the release folder DIR, a direct child of the releases folder, through its MANIFEST:
# the files it lists, the MANIFEST, then the folders left empty. Follows no symlink and removes
# nothing else; warns and returns 1 when DIR stays in place.
remove_release_dir() {
    local dir=$1 line rel parent
    local -a rels=() parents=()
    if [[ ${dir%/*} != "$RELEASES_DIR" || -L $dir || ! -d $dir ]]; then
        warn "left $(shown "$dir") in place: it is not a release folder"
        return 1
    fi
    if [[ -L $dir/MANIFEST || ! -f $dir/MANIFEST || ! -r $dir/MANIFEST ]]; then
        # A build that stopped before its MANIFEST was written leaves an empty folder.
        if rmdir -- "$dir" 2> /dev/null; then
            return 0
        fi
        warn "left $(shown "$dir") in place: it has no readable MANIFEST"
        return 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ ! $line =~ $MANIFEST_RE ]]; then
            warn "left $(shown "$dir") in place: its MANIFEST holds a line tlogger cannot read"
            return 1
        fi
        rels+=("${BASH_REMATCH[1]}")
    done < "$dir/MANIFEST"
    for rel in "${rels[@]}"; do
        if path_has_link "$dir" "$rel"; then
            warn "left $(shown "$dir/$rel") in place: a symlink is in its path"
            continue
        fi
        if [[ -f $dir/$rel ]]; then
            rm -f -- "$dir/$rel" 2> /dev/null || warn "cannot delete $(shown "$dir/$rel")"
        fi
        parent=$rel
        while [[ $parent == */* ]]; do
            parent=${parent%/*}
            parents+=("$parent")
        done
    done
    rm -f -- "$dir/MANIFEST" 2> /dev/null || warn "cannot delete $(shown "$dir/MANIFEST")"
    # A reverse sort puts a/b before a, so the deepest folders go first.
    if (( ${#parents[@]} )); then
        while IFS= read -r parent; do
            if [[ ! -L $dir/$parent ]]; then
                rmdir -- "$dir/$parent" 2> /dev/null || true
            fi
        done < <(printf '%s\n' "${parents[@]}" | LC_ALL=C sort -r -u)
    fi
    if ! rmdir -- "$dir" 2> /dev/null; then
        warn "left $(shown "$dir") in place: it holds files tlogger did not install"
        return 1
    fi
}

# Succeed when any code is installed: the current link or the releases folder exists.
code_present() {
    [[ -L $CURRENT_LINK || -e $CURRENT_LINK || -e $RELEASES_DIR || -L $RELEASES_DIR ]]
}

# Install this source tree's release, point current at it and prune old releases. Skips the
# copy when the source tree is that release or the release already matches its MANIFEST. Sets
# CODE_NOTE for the summary.
install_code() {
    local dest=$RELEASES_DIR/$VERSION_STR previous
    make_parent "$DATA_HOME"
    ensure_dir "$DATA_DIR" 755
    ensure_dir "$RELEASES_DIR" 755
    previous=$(current_release)
    if [[ -d $dest && ! -L $dest && $(readlink -f -- "$dest") == "$SRC_ROOT" ]]; then
        CODE_NOTE="kept: tlogger runs from this release"
    elif release_matches "$dest"; then
        CODE_NOTE="already up to date"
    else
        build_release
        place_release "$dest"
        CODE_NOTE="installed"
    fi
    switch_current
    prune_releases "$previous"
}

# Remove the code: the current link, every entry of the releases folder that is a release
# folder, through its MANIFEST, then the releases and data folders when they are empty. Warns
# about each thing it leaves in place.
remove_code() {
    local entry
    if [[ -L $CURRENT_LINK ]]; then
        rm -f -- "$CURRENT_LINK" 2> /dev/null || die 1 "cannot remove $(shown "$CURRENT_LINK")"
    fi
    if [[ -d $RELEASES_DIR && ! -L $RELEASES_DIR ]]; then
        while IFS= read -r -d '' entry; do
            remove_release_dir "$entry" || true
        done < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -print0 2> /dev/null)
        rmdir -- "$RELEASES_DIR" 2> /dev/null ||
            warn "left $(shown "$RELEASES_DIR") in place: it is not empty"
    fi
    if [[ -d $DATA_DIR && ! -L $DATA_DIR ]]; then
        rmdir -- "$DATA_DIR" 2> /dev/null ||
            warn "left $(shown "$DATA_DIR") in place: it holds files tlogger did not install"
    fi
}

# Print on stdout, indented and in the ~ form, what remove_code and --purge-config remove: the
# current link, the files each release's MANIFEST lists with the MANIFEST, and the config. Marks
# what remove_release_dir leaves in place: a folder without a readable MANIFEST, and a file with
# a symlink in its path.
print_removals() {
    local entry line rel bad
    local -a rels
    if [[ -L $CURRENT_LINK ]]; then
        printf '  %s\n' "$(shown "$CURRENT_LINK")"
    fi
    if [[ -d $RELEASES_DIR && ! -L $RELEASES_DIR ]]; then
        while IFS= read -r -d '' entry; do
            if [[ -L $entry || ! -d $entry || -L $entry/MANIFEST || ! -f $entry/MANIFEST ||
                ! -r $entry/MANIFEST ]]; then
                printf '  (left in place: %s)\n' "$(shown "$entry")"
                continue
            fi
            rels=() bad=0
            while IFS= read -r line || [[ -n $line ]]; do
                if [[ ! $line =~ $MANIFEST_RE ]]; then
                    bad=1
                    break
                fi
                rels+=("${BASH_REMATCH[1]}")
            done < "$entry/MANIFEST"
            if (( bad )); then
                printf '  (left in place: %s)\n' "$(shown "$entry")"
                continue
            fi
            for rel in "${rels[@]}"; do
                if path_has_link "$entry" "$rel"; then
                    printf '  (left in place: %s, a symlink is in its path)\n' "$(shown "$entry/$rel")"
                else
                    printf '  %s\n' "$(shown "$entry/$rel")"
                fi
            done
            printf '  %s\n' "$(shown "$entry/MANIFEST")"
        done < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -print0 2> /dev/null | LC_ALL=C sort -z)
    fi
    if (( OPT_PURGE_CONFIG )) && [[ -f $CONFIG_FILE && ! -L $CONFIG_FILE ]]; then
        printf '  %s\n' "$(shown "$CONFIG_FILE")"
    fi
    printf '  and the folders these leave empty\n'
}

# =======================================================
#                   CONFIG AND STATE
# =======================================================

# Exit 1 when the folder DIR exists and is a symlink, not a folder, or another user's.
# A missing DIR passes; nothing is created.
check_dir_safe() {
    local dir=$1
    if [[ -L $dir ]]; then
        die 1 "$(shown "$dir") is a symlink, which tlogger does not follow; remove it or replace it with a folder"
    fi
    if [[ ! -e $dir ]]; then
        return 0
    fi
    if [[ ! -d $dir ]]; then
        die 1 "$(shown "$dir") is not a folder"
    fi
    if [[ ! -O $dir ]]; then
        die 1 "$(shown "$dir") belongs to another user"
    fi
}

# Create FOLDER and its missing parents with mode 0700, as the XDG base directory spec asks: the
# umask of the subshell gives every level that mode. An existing FOLDER is left as it is.
make_parent() {
    if [[ ! -d $1 ]]; then
        (umask 077 && mkdir -p -- "$1") 2> /dev/null || die 1 "cannot create $(shown "$1")"
    fi
}

# Exit 1 unless install can create the folder DIR or write in it: DIR, or else the nearest folder
# above it that exists, must be a folder this user can write in. Checks only; creates nothing.
check_writable() {
    local dir=$1
    while [[ ! -e $dir && ! -L $dir ]]; do
        dir=${dir%/*}
        dir=${dir:-/}
    done
    if [[ ! -d $dir ]]; then
        die 1 "cannot create $(shown "$1"): $(shown "$dir") is not a folder"
    fi
    if [[ ! -w $dir || ! -x $dir ]]; then
        die 1 "cannot write in $(shown "$dir"), which install needs for $(shown "$1")"
    fi
}

# Create the folder DIR with mode MODE (755 or 700) when it is missing, else check it with
# check_dir_safe; an existing folder of mode 700 is tightened to 0700. A private folder is made
# with mkdir -m 700; a code folder goes through install -d, as the release folders do.
ensure_dir() {
    local dir=$1 mode=$2
    check_dir_safe "$dir"
    if [[ -d $dir ]]; then
        if [[ $mode == 700 ]]; then
            chmod 700 -- "$dir" 2> /dev/null || die 1 "cannot set mode 0700 on $(shown "$dir")"
        fi
    elif [[ $mode == 700 ]]; then
        mkdir -m 700 -- "$dir" 2> /dev/null || die 1 "cannot create $(shown "$dir")"
    else
        install -d -m "$mode" -- "$dir" 2> /dev/null || die 1 "cannot create $(shown "$dir")"
    fi
}

# Read the config into CONFIG_MODE, CONFIG_LOGDIR, CONFIG_ENGAGEMENT and CONFIG_LOGDIR_MOUNT
# without running it, by the line rules of lib/config.zsh: key=value lines, blank lines and '#'
# comments, with the whitespace around a value trimmed and the trailing slashes of a logdir or a
# logdir_mount dropped; an empty engagement or logdir_mount means none. Every other key, the
# plugin's record_input, min_free_mb, record_ssh, record_tmux, recorder, prompt, prompt_time,
# stamp, stamp_vpn, vpn_ifaces and history_timestamps included, is accepted unchecked, and install
# keeps its line as it is; the recorder value goes to CONFIG_RECORDER and its line number to
# CONFIG_RECORDER_LINE, for resolve_recorder. Sets CONFIG_ERROR, instead of exiting, for an
# unsafe file, a bad line, a repeated key or an invalid mode, logdir, engagement or logdir_mount.
# An invalid engagement does not stop the reading, so that any other error still wins; when it is
# the only one, CONFIG_ENGAGEMENT_BAD is 1 and the other values are read.
read_config() {
    local line key value n=0 bad_engagement=''
    local blank_re='^[[:space:]]*(#|$)' key_re='^[a-z][a-z0-9_]*='
    local -A seen=()
    CONFIG_MODE='' CONFIG_LOGDIR='' CONFIG_RECORDER='' CONFIG_RECORDER_LINE=0 CONFIG_ERROR=''
    CONFIG_ENGAGEMENT='' CONFIG_LOGDIR_MOUNT='' CONFIG_ENGAGEMENT_BAD=0
    if [[ ! -e $CONFIG_FILE && ! -L $CONFIG_FILE ]]; then
        return 0
    fi
    if [[ -L $CONFIG_FILE || ! -f $CONFIG_FILE ]]; then
        CONFIG_ERROR="is a symlink or not a regular file"
        return 0
    fi
    if [[ ! -O $CONFIG_FILE ]]; then
        CONFIG_ERROR="belongs to another user"
        return 0
    fi
    if [[ ! -r $CONFIG_FILE ]]; then
        CONFIG_ERROR="is not readable"
        return 0
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        n=$(( n + 1 ))
        if [[ $line =~ $blank_re ]]; then
            continue
        fi
        if [[ ! $line =~ $key_re ]]; then
            CONFIG_ERROR="has line $n, which is not a key=value line"
            return 0
        fi
        key=${line%%=*}
        value=${line#*=}
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        if [[ -n ${seen[$key]+set} ]]; then
            CONFIG_ERROR="repeats the key $key on line $n"
            return 0
        fi
        seen[$key]=1
        case $key in
            mode)
                if [[ $value != auto && $value != manual ]]; then
                    CONFIG_ERROR="has a mode on line $n that is neither auto nor manual"
                    return 0
                fi
                CONFIG_MODE=$value
                ;;
            logdir)
                while [[ $value == */ && $value != / ]]; do
                    value=${value%/}
                done
                if [[ $value != /* || $value == *[[:cntrl:]]* ]]; then
                    CONFIG_ERROR="has a logdir on line $n that is not an absolute path"
                    return 0
                fi
                CONFIG_LOGDIR=$value
                ;;
            engagement)
                if [[ -n $value ]] && ! engagement_name_ok "$value"; then
                    bad_engagement="has an engagement on line $n that is not a valid name"
                    continue
                fi
                CONFIG_ENGAGEMENT=$value
                ;;
            logdir_mount)
                while [[ $value == */ && $value != / ]]; do
                    value=${value%/}
                done
                if [[ -n $value && ( $value != /* || $value == *[[:cntrl:]]* ) ]]; then
                    CONFIG_ERROR="has a logdir_mount on line $n that is not an absolute path"
                    return 0
                fi
                CONFIG_LOGDIR_MOUNT=$value
                ;;
            recorder)
                CONFIG_RECORDER=$value
                CONFIG_RECORDER_LINE=$n
                ;;
        esac
    done < "$CONFIG_FILE"
    if [[ -n $bad_engagement ]]; then
        CONFIG_ERROR=$bad_engagement CONFIG_ENGAGEMENT_BAD=1
    fi
}

# Succeed when NAME is a valid engagement name: ENGAGEMENT_RE, and neither MANIFEST nor a name
# shaped like a session id, which would mix with the sessions of the log folder.
engagement_name_ok() {
    # Byte ranges, as the plugin checks them: in some locales [A-Za-z] matches more letters.
    local LC_ALL=C
    [[ $1 =~ $ENGAGEMENT_RE && $1 != MANIFEST && ! $1 =~ $SESSION_NAME_RE ]]
}

# Write the config CONTENT read from stdin to a temp file in the config folder, mode 0600, and
# rename it over the config. Exits 1 when it cannot be written.
replace_config() {
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a temp file in $(shown "$CONFIG_DIR")"
    TEMP_PATHS+=("$tmp")
    { cat > "$tmp"; } 2> /dev/null || die 1 "cannot write a temp file in $(shown "$CONFIG_DIR")"
    chmod 600 -- "$tmp" 2> /dev/null || die 1 "cannot set mode 0600 on a temp file in $(shown "$CONFIG_DIR")"
    mv -T -f -- "$tmp" "$CONFIG_FILE" 2> /dev/null || die 1 "cannot write $(shown "$CONFIG_FILE")"
}

# Print the config with its first KEY= line set to KEY=VALUE, or with KEY=VALUE appended as a new
# line when there is none, and every other byte as it is. The changed line keeps a CR before its
# line end, and a last line without a newline stays without one, unless the new line follows it.
# Returns 1 when the config cannot be opened or any write fails, such as on a full disk, so that
# no caller renames a copy cut short over the config. Callers run it left of ||, where errexit
# does not apply, so each write checks its own status.
config_with() {
    local key=$1 value=$2 line eol cr done=0
    while true; do
        eol=$'\n'
        # read fails at the end of the file, and also on a last line without a newline.
        if ! IFS= read -r line; then
            if [[ -z $line ]]; then
                break
            fi
            eol=
        fi
        if (( ! done )) && [[ $line == "$key="* ]]; then
            cr=
            if [[ $line == *$'\r' ]]; then
                cr=$'\r'
            fi
            line=$key=$value$cr
            done=1
        fi
        printf '%s%s' "$line" "$eol" || return 1
        if [[ -z $eol ]]; then
            break
        fi
    done < "$CONFIG_FILE" || return 1
    if (( ! done )); then
        if [[ -z $eol ]]; then
            printf '\n' || return 1
        fi
        printf '%s=%s\n' "$key" "$value" || return 1
    fi
}

# Create the config folder (0700) and the config (0600) with mode and logdir, or change only the
# mode in an existing config when --mode asks for another one. Tightens an existing config to
# 0600. Exits 1 for an unsafe or invalid config, which check_targets has already refused.
install_config() {
    make_parent "$CONFIG_HOME"
    ensure_dir "$CONFIG_DIR" 700
    read_config
    if [[ -n $CONFIG_ERROR ]]; then
        die 1 "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; fix it by hand"
    fi
    if [[ ! -e $CONFIG_FILE ]]; then
        replace_config << EOF
# tlogger settings: key=value lines and # comments. tlogger reads this file as data and never runs it.
# mode: auto records every new terminal, manual only on tlogger start.
# Optional: record_input=yes|no (default yes), min_free_mb=<MB> (default 200),
# record_ssh=yes|no (default yes) for SSH logins, record_tmux=yes|no (default yes) for tmux panes,
# prompt=on|off (default on) for the time, VPN and REC/NOREC/EXT segment in the prompt,
# prompt_time=iso|readable (default readable) for its time, stamp=on|off|hidden (default hidden)
# for the UTC stamp at each recorded command (hidden: kept in the recording, not shown),
# stamp_vpn=on|off (default on) for the VPN addresses in both, vpn_ifaces=<patterns> (default
# tun* wg* tap*) for the VPN interfaces, and history_timestamps=yes|no (default no) for start
# times in the zsh history.
# engagement=<name> (default none) puts new sessions into the folder <name> in logdir, as
# tlogger engagement sets it, and logdir_mount=<absolute path> (default none) makes a recording
# refuse while the volume mounted there is not mounted or does not hold logdir.
mode=$MODE
logdir=$SESSIONS_DIR
EOF
    elif [[ $MODE != "$CONFIG_MODE" ]]; then
        # Through a file, not a pipe, so that replace_config runs in this shell and cleanup
        # knows its temp file.
        { config_with mode "$MODE" > "$WORK/config"; } 2> /dev/null ||
            die 1 "cannot copy $(shown "$CONFIG_FILE") to the temp folder"
        replace_config < "$WORK/config"
    fi
    chmod 600 -- "$CONFIG_FILE" 2> /dev/null || die 1 "cannot set mode 0600 on $(shown "$CONFIG_FILE")"
    read_config
}

# Remove the config and, when nothing else is in it, the config folder.
# Leaves a symlink in place, as everything tlogger removes.
purge_config() {
    if [[ -f $CONFIG_FILE && ! -L $CONFIG_FILE ]]; then
        rm -f -- "$CONFIG_FILE" 2> /dev/null || die 1 "cannot delete $(shown "$CONFIG_FILE")"
    fi
    if [[ -d $CONFIG_DIR && ! -L $CONFIG_DIR ]]; then
        rmdir -- "$CONFIG_DIR" 2> /dev/null ||
            warn "left $(shown "$CONFIG_DIR") in place: it holds other files"
    fi
}

# Create the state folder with its rc-backups and sessions folders, all mode 0700, or check and
# tighten existing ones to 0700.
install_state() {
    make_parent "$STATE_HOME"
    ensure_dir "$STATE_DIR" 700
    ensure_dir "$BACKUP_DIR" 700
    ensure_dir "$SESSIONS_DIR" 700
}

# Refuse, before anything is written, existing tlogger folders that are symlinks, not folders or
# another user's, a current entry that is not a symlink, a current release newer than this one,
# an unsafe or invalid config, and a folder that install could not create or write in: the code,
# config and state folders, and the rc's folder when the rc is created or renamed into place.
# Call once RC_CHANGED is known. Failures it cannot foresee, such as a full disk, still stop
# install part way, and a later install completes it.
check_targets() {
    local dir links
    for dir in "$DATA_DIR" "$RELEASES_DIR" "$CONFIG_DIR" "$STATE_DIR" "$BACKUP_DIR" "$SESSIONS_DIR"; do
        check_dir_safe "$dir"
    done
    if (( OPT_REMOVE || OPT_QUARANTINE_SET )); then
        check_dir_safe "$QUARANTINE_DIR"
    fi
    if [[ -e $CURRENT_LINK && ! -L $CURRENT_LINK ]]; then
        die 1 "$(shown "$CURRENT_LINK") is not a symlink; remove it by hand"
    fi
    refuse_downgrade
    read_config
    if [[ -n $CONFIG_ERROR ]]; then
        die 1 "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; fix it by hand"
    fi
    for dir in "$DATA_DIR" "$RELEASES_DIR" "$CONFIG_DIR" "$BACKUP_DIR" "$SESSIONS_DIR"; do
        check_writable "$dir"
    done
    if (( OPT_REMOVE || OPT_QUARANTINE_SET )); then
        check_writable "$QUARANTINE_DIR"
    fi
    if (( RC_CHANGED )) && [[ $RC_STATE != foreign ]]; then
        # classify_rc has made sure that an existing rc is writable; a hard-linked one is written
        # in place, any other one goes through a temp file in its folder.
        links=1
        if [[ $RC_STATE == regular ]]; then
            links=$(stat -c %h -- "$RC" 2> /dev/null) || links=1
        fi
        if (( links == 1 )); then
            check_writable "$ZDOT"
        fi
    fi
}

# =======================================================
#                     MODE AND PROBE
# =======================================================

# Set MODE from --mode, else from the existing config, else from a question on the terminal.
# Exits 2 when none of them gives one. Call after check_targets, which reads the config.
choose_mode() {
    local answer tries
    if [[ -n $OPT_MODE ]]; then
        MODE=$OPT_MODE
        return 0
    fi
    if [[ -n $CONFIG_MODE ]]; then
        MODE=$CONFIG_MODE
        return 0
    fi
    if ! on_tty; then
        die 2 "--mode is required when not run from a terminal"
    fi
    for tries in 1 2 3; do
        printf 'tlogger: record every new terminal (auto) or only on request (manual)? [auto/manual] ' >&2
        IFS= read -r answer || die 2 "no mode given; pass --mode auto or --mode manual"
        case $answer in
            auto | manual)
                MODE=$answer
                return 0
                ;;
        esac
        msg "answer auto or manual (attempt $tries of 3)"
    done
    die 2 "no mode given; pass --mode auto or --mode manual"
}

# Start an interactive zsh, as a new terminal does but with stdin from /dev/null, and report
# whether the plugin loaded. Only reports: the exit status does not depend on it. setsid, where it
# exists, leaves the zsh without a controlling terminal, so that the rc can neither prompt nor
# take the terminal over. An interactive zsh ignores TERM, so -k 2 follows with KILL, and the
# answer goes to a file, which a job the rc leaves running cannot hold open as it can a pipe.
probe_plugin() {
    local -a detach=()
    if command -v setsid > /dev/null 2>&1; then
        detach=(setsid)
    fi
    timeout -k 2 10 "${detach[@]}" zsh -i -c "$ZSH_PROBE" < /dev/null > "$WORK/probe" 2> /dev/null || true
    if grep -qx 'TLOGGER_PROBE:loaded' "$WORK/probe" 2> /dev/null; then
        msg "plugin loaded: a new zsh terminal defines the tlogger command"
    else
        warn "a new interactive zsh did not load the plugin; open a new terminal and run 'tlogger status' there"
    fi
}

# =======================================================
#                   RECORDER SMOKE TEST
# =======================================================

# Set RECORDER to the recorder that auto mode runs, picked as lib/config.zsh picks it: an exported,
# non-empty TLOGGER_RECORDER, trimmed, else the config's recorder=, else /usr/bin/script. A value
# that is not an absolute path without control characters gets one warning and the default. Call
# after read_config.
resolve_recorder() {
    local value origin
    RECORDER=/usr/bin/script
    if [[ -n ${TLOGGER_RECORDER-} && ${TLOGGER_RECORDER@a} == *x* ]]; then
        value=$TLOGGER_RECORDER
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        origin=TLOGGER_RECORDER
    elif (( CONFIG_RECORDER_LINE )); then
        value=$CONFIG_RECORDER
        origin="$(shown "$CONFIG_FILE") line $CONFIG_RECORDER_LINE"
    else
        return 0
    fi
    if [[ $value != /* || $value == *[[:cntrl:]]* ]]; then
        warn "$origin: recorder must be an absolute path; using /usr/bin/script"
        return 0
    fi
    RECORDER=$value
}

# Run RECORDER once as auto mode runs it, but with the command true, in a new private temp folder
# SMOKE_DIR: 'TZ=UTC0 RECORDER --quiet --logging-format advanced --log-timing SMOKE_DIR/timing
# --log-out SMOKE_DIR/output.raw --command true', with stdin from /dev/null, the output dropped
# and, where timeout exists, a limit of 10 seconds. Succeeds when the recorder exits 0 and both
# logs exist; a recorder that is missing, not executable or lacks --logging-format fails, as does
# one that fails or times out. Removes the folder again; exits 1 when it cannot create it.
smoke_test() {
    local status=0
    local -a limit=()
    SMOKE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/tlogger-smoke.XXXXXX" 2> /dev/null) ||
        die 1 "cannot create a temp folder in $(shown "${TMPDIR:-/tmp}")"
    if command -v timeout > /dev/null 2>&1; then
        # -k 2 follows with KILL when the recorder ignores TERM.
        limit=(timeout -k 2 10)
    fi
    TZ=UTC0 "${limit[@]}" "$RECORDER" --quiet --logging-format advanced \
        --log-timing "$SMOKE_DIR/timing" --log-out "$SMOKE_DIR/output.raw" --command true \
        < /dev/null > /dev/null 2>&1 || status=$?
    if (( status == 0 )) && [[ ! -f $SMOKE_DIR/timing || ! -f $SMOKE_DIR/output.raw ]]; then
        status=1
    fi
    remove_smoke_dir
    return "$status"
}

# Remove the smoke test's folder SMOKE_DIR with the plain files in it, without rm -r, and clear
# SMOKE_DIR. Ignores every failure, so that cleanup can call it at any time.
remove_smoke_dir() {
    if [[ -n $SMOKE_DIR && -d $SMOKE_DIR && ! -L $SMOKE_DIR ]]; then
        rm -f -- "$SMOKE_DIR"/* 2> /dev/null || true
        rmdir -- "$SMOKE_DIR" 2> /dev/null || true
    fi
    SMOKE_DIR=
}

# Exit 1 unless the recorder that auto mode would run, as resolve_recorder picks it, passes the
# smoke test. The message ends in HINT, which says what to do instead.
require_working_recorder() {
    resolve_recorder
    if ! smoke_test; then
        die 1 "auto mode needs a working recorder: $(shown "$RECORDER") failed its smoke test; $1"
    fi
}

# =======================================================
#                         INSTALL
# =======================================================

# Exit 2 unless MARKER can name a whole line of the rc: it holds text and no control character,
# and it is not tlogger's own marker. Usage errors never repeat a marker.
check_marker() {
    if [[ -z ${1//[[:space:]]/} ]]; then
        usage_error "a --remove-block marker is empty or blank"
    fi
    if [[ $1 == *[[:cntrl:]]* ]]; then
        usage_error "a --remove-block marker holds a control character"
    fi
    if [[ $1 == "$START_MARK" || $1 == "$END_MARK" ]]; then
        usage_error "a --remove-block marker is tlogger's own marker line"
    fi
}

# Exit 2 for a combination of the migration options that install does not take.
check_migration_options() {
    if (( OPT_PRINT_ONLY && ( OPT_REMOVE || OPT_BLOCK_SHA_SET || OPT_QUARANTINE_SET ) )); then
        usage_error "--print-only does not go with --remove-block, --block-sha256 or --quarantine"
    fi
    if (( OPT_BLOCK_SHA_SET && ! OPT_REMOVE )); then
        usage_error "--block-sha256 needs --remove-block"
    fi
    if (( OPT_BLOCK_SHA_SET )) && [[ ! $OPT_BLOCK_SHA =~ ^[0-9a-fA-F]{64}$ ]]; then
        usage_error "--block-sha256 takes 64 hex characters, as a dry run prints them"
    fi
    if (( OPT_REMOVE )); then
        check_marker "$OPT_LEGACY_START"
        check_marker "$OPT_LEGACY_END"
        if [[ $OPT_LEGACY_START == "$OPT_LEGACY_END" ]]; then
            usage_error "the two --remove-block markers are the same line"
        fi
        if (( OPT_YES && ! OPT_DRY_RUN && ! OPT_BLOCK_SHA_SET )); then
            usage_error "--yes with --remove-block needs --block-sha256, the fingerprint a dry run prints"
        fi
    fi
    if (( OPT_QUARANTINE_SET )); then
        if [[ -z $OPT_QUARANTINE ]]; then
            usage_error "--quarantine needs a file"
        fi
        if [[ $OPT_QUARANTINE != /* ]]; then
            OPT_QUARANTINE=$PWD/$OPT_QUARANTINE
        fi
    fi
}

# Parse the install options into OPT_MODE, OPT_DRY_RUN, OPT_YES, OPT_PRINT_ONLY and the migration
# options. --remove-block takes the next two arguments as they are, whatever they start with.
# Exits 2 on an unknown or repeated option or a bad value; -h and --help print the usage and exit 0.
parse_install_options() {
    local value
    while (( $# )); do
        case $1 in
            --mode | --mode=*)
                if [[ $1 == --mode=* ]]; then
                    value=${1#--mode=}
                    shift
                else
                    (( $# >= 2 )) || usage_error "--mode needs a value: auto or manual"
                    value=$2
                    shift 2
                fi
                if [[ $value != auto && $value != manual ]]; then
                    usage_error "--mode takes auto or manual, not '$value'"
                fi
                OPT_MODE=$value
                ;;
            --dry-run) OPT_DRY_RUN=1; shift ;;
            --yes) OPT_YES=1; shift ;;
            --print-only) OPT_PRINT_ONLY=1; shift ;;
            --remove-block)
                (( $# >= 3 )) || usage_error "--remove-block needs two values: START and END"
                (( ! OPT_REMOVE )) || usage_error "--remove-block is given more than once"
                OPT_REMOVE=1 OPT_LEGACY_START=$2 OPT_LEGACY_END=$3
                shift 3
                ;;
            --block-sha256 | --block-sha256=*)
                (( ! OPT_BLOCK_SHA_SET )) || usage_error "--block-sha256 is given more than once"
                OPT_BLOCK_SHA_SET=1
                if [[ $1 == *=* ]]; then
                    OPT_BLOCK_SHA=${1#*=}
                    shift
                else
                    (( $# >= 2 )) || usage_error "--block-sha256 needs a value"
                    OPT_BLOCK_SHA=$2
                    shift 2
                fi
                ;;
            --quarantine | --quarantine=*)
                (( ! OPT_QUARANTINE_SET )) || usage_error "--quarantine is given more than once"
                OPT_QUARANTINE_SET=1
                if [[ $1 == *=* ]]; then
                    OPT_QUARANTINE=${1#*=}
                    # The shell does not expand a ~ after the = of an option.
                    # shellcheck disable=SC2088 # The ~ is text here.
                    if [[ $OPT_QUARANTINE == '~/'* ]]; then
                        OPT_QUARANTINE=${HOME-}/${OPT_QUARANTINE#'~/'}
                    fi
                    shift
                else
                    (( $# >= 2 )) || usage_error "--quarantine needs a file"
                    OPT_QUARANTINE=$2
                    shift 2
                fi
                ;;
            -h | --help) usage; exit 0 ;;
            *)
                # After --remove-block any other word may belong to an unquoted marker, so only
                # the name of what looks like an option is repeated.
                if (( OPT_REMOVE )); then
                    if [[ $1 =~ ^--[a-z][a-z0-9-]*(=|$) ]]; then
                        usage_error "unknown option for install: ${1%%=*}"
                    fi
                    usage_error "unexpected argument after --remove-block; quote both markers"
                fi
                usage_error "unknown option for install: $1"
                ;;
        esac
    done
    if (( OPT_DRY_RUN && OPT_PRINT_ONLY )); then
        usage_error "--dry-run and --print-only do not go together"
    fi
    check_migration_options
}

# Print the question install asks before it writes, naming the old block's removal and the stale
# backup's move whenever those options are given.
install_question() {
    local action
    if (( ! RC_CHANGED )); then
        action="Refresh the tlogger code and config"
    elif (( OPT_REMOVE )) && own_block_current; then
        action="Keep the tlogger block in $(shown "$RC")"
    elif (( SCAN_START )); then
        action="Update the tlogger block in $(shown "$RC")"
    else
        action="Add the tlogger block to $(shown "$RC")"
    fi
    if (( OPT_REMOVE )); then
        action="Remove the old block at lines $LEGACY_FROM-$LEGACY_TO of $(shown "$RC"), ${action,}"
    fi
    if [[ -n $OPT_QUARANTINE ]]; then
        action+=", and move $(shown "$OPT_QUARANTINE") into $(shown "$QUARANTINE_DIR")"
    fi
    printf '%s?\n' "$action"
}

# Print LABEL VALUE pairs as rows of the install plan. Only a migration run, with its longer
# labels, widens the column, so that a plain install prints what it always printed.
plan_rows() {
    local width=9
    if (( OPT_REMOVE || OPT_QUARANTINE_SET )); then
        width=10
    fi
    while (( $# )); do
        printf '  %-*s %s\n' "$width" "$1" "$2"
        shift 2
    done
}

# Print the install plan on stdout: the rc and what happens to it, the old block and the stale
# backup when they are named, the mode, the version and the code, config and state paths, then
# the diff of the rc when it changes.
print_install_plan() {
    local note old_label
    old_label=$(shown "$RC")
    if (( OPT_REMOVE )); then
        note="old block at lines $LEGACY_FROM-$LEGACY_TO removed; "
        if (( SCAN_START == 0 )); then
            note+="tlogger block added at lines 1-4"
        elif own_block_current; then
            note+="tlogger block at lines $SCAN_START-$SCAN_END kept"
        else
            note+="tlogger block at lines $SCAN_START-$SCAN_END replaced"
        fi
    elif [[ $RC_STATE == missing ]]; then
        if [[ -n $SEED ]]; then
            note="missing; created from $(shown "$SEED") with the block at lines 1-4"
            old_label=$(shown "$SEED")
        else
            note="missing; created with the block at lines 1-4"
            old_label="$old_label (missing)"
        fi
    elif (( SCAN_START == 0 )); then
        note="the block is added at lines 1-4"
    elif (( RC_CHANGED )); then
        note="the block at lines $SCAN_START-$SCAN_END is replaced"
    else
        note="the block at lines $SCAN_START-$SCAN_END is up to date; no change"
    fi
    printf 'tlogger install plan\n'
    plan_rows rc: "$(shown "$RC") ($note)"
    if (( OPT_REMOVE )); then
        plan_rows \
            'old block:' "$(( LEGACY_TO - LEGACY_FROM + 1 )) lines, sha256 $LEGACY_SHA" \
            'saved to:' "$(shown "$QUARANTINE_DIR")/removed-block.L$(legacy_return_line).<UTC time>.<random> (0600)"
    fi
    if (( OPT_QUARANTINE_SET )); then
        plan_rows stale: "$(shown "$OPT_QUARANTINE"), $(human_size "$STALE_SIZE"), $STALE_DATE, moves to quarantine/ (0600, now 0$STALE_MODE)"
    fi
    plan_rows \
        mode: "$MODE" \
        version: "$VERSION_STR" \
        code: "$(shown "$RELEASES_DIR/$VERSION_STR"), linked from $(shown "$CURRENT_LINK")" \
        config: "$(shown "$CONFIG_FILE")" \
        state: "$(shown "$STATE_DIR")"
    if (( RC_CHANGED )); then
        show_diff put "$old_label" "$(shown "$RC") (new)"
    fi
}

# Print the install summary on stdout: rc, mode, version, logdir, backup and how to uninstall.
print_install_summary() {
    local backup_note="none: the rc did not change"
    if [[ -n $BACKUP ]]; then
        backup_note=$(shown "$BACKUP")
    elif [[ $RC_STATE == missing ]]; then
        backup_note="none: there was no rc"
    fi
    if [[ $MODE == auto ]]; then
        printf 'tlogger %s is installed. Every new zsh terminal records itself, and tlogger stop pauses.\n' "$VERSION_STR"
    else
        printf 'tlogger %s is installed. In a new zsh terminal, tlogger start records it and tlogger stop pauses.\n' "$VERSION_STR"
    fi
    printf '  %-10s %s\n' \
        rc: "$(shown "$RC")" \
        mode: "$MODE" \
        version: "$VERSION_STR" \
        code: "$(shown "$RELEASES_DIR/$VERSION_STR") ($CODE_NOTE)" \
        logdir: "$(shown "${CONFIG_LOGDIR:-$SESSIONS_DIR}")" \
        backup: "$backup_note" \
        uninstall: "tlogger uninstall, in a new terminal; or $(shown "$CURRENT_LINK/bin/tlogger") uninstall"
    if [[ -n $STALE_MOVED ]]; then
        printf '  %-10s %s\n' moved: "$(shown "$OPT_QUARANTINE") to $(shown "$STALE_MOVED"), mode 0600; its mode was 0$STALE_MODE"
    fi
    if (( OPT_REMOVE )); then
        printf 'Terminals that are already open keep the old logger until you close them.\n'
    fi
}

# tlogger install: put the block at the top of the rc and install the code, config and state.
# --remove-block cuts the old block in that write; --quarantine then moves a stale backup last.
# --dry-run and --print-only leave nothing; other runs write only temp files until all checks pass.
cmd_install() {
    local sum
    parse_install_options "$@"
    refuse_foreign_root
    read_version
    check_source_tree
    check_release_manifest
    resolve_paths
    build_block
    if (( OPT_PRINT_ONLY )); then
        printf '%s' "$BLOCK"
        return 0
    fi
    if (( ! OPT_DRY_RUN )); then
        make_work
    fi
    check_recorder
    classify_rc
    if (( OPT_REMOVE )) && [[ $RC_STATE == missing ]]; then
        refuse_no_block "there is no $(shown "$RC"), so there is no old block to remove"
    fi
    # Without the rc's text there are no line numbers to name, so a person removes the old block.
    if (( OPT_REMOVE )) && [[ $RC_STATE != missing && ( ! -f $RC || ! -r $RC ) ]]; then
        msg "$(shown "$RC") cannot be read, so tlogger could not locate the old block; remove it by hand"
        RC_WHY=${RC_WHY:-cannot be read}
        SCAN_START=0 SCAN_END=0
        print_by_hand
        note_quarantine_followup
        exit 1
    fi
    if [[ $RC_STATE == missing ]]; then
        seed_rc
    else
        copy_rc
    fi
    if [[ -z $OLD_RC ]]; then
        SCAN_START=0 SCAN_END=0
        print_by_hand
        note_quarantine_followup
        exit 1
    fi
    if (( OPT_DRY_RUN && OPT_REMOVE )); then
        sum=$({ sha256sum < "$OLD_RC"; } 2> /dev/null) || die 1 "cannot read $(shown "$RC")"
        DRY_RUN_RC_SHA=${sum%% *}
    fi
    if (( OPT_REMOVE )); then
        find_legacy_block
    fi
    scan_file "$OLD_RC" "$LEGACY_FROM" "$LEGACY_TO"
    refuse_bad_markers
    if (( OPT_REMOVE )); then
        refuse_block_overlap
    fi
    refuse_foreign_recorder
    if (( ! OPT_DRY_RUN )); then
        build_rc put
    fi
    RC_CHANGED=1
    if [[ $RC_STATE != missing ]] && ! new_rc_differs put; then
        RC_CHANGED=0
    fi
    if [[ $RC_STATE == foreign ]] && (( RC_CHANGED )); then
        if (( OPT_REMOVE )); then
            print_cut_by_hand
        else
            print_by_hand
        fi
        note_quarantine_followup
        exit 1
    fi
    check_targets
    if (( OPT_QUARANTINE_SET )); then
        check_stale_file
    fi
    choose_mode
    if (( ! OPT_DRY_RUN && ! OPT_YES )) && ! on_tty; then
        die 2 "--yes is required when not run from a terminal"
    fi
    if [[ $MODE == auto ]]; then
        require_working_recorder "install with --mode manual, or fix script"
    fi
    if (( RC_CHANGED )); then
        check_syntax put
    fi
    if (( ! OPT_DRY_RUN )); then
        make_manifest
    fi
    print_install_plan
    if (( ! RC_CHANGED )); then
        msg "already installed, block up to date"
    fi
    if (( OPT_DRY_RUN )); then
        if [[ -n $DRY_RUN_RC_SHA ]]; then
            sum=$({ sha256sum < "$OLD_RC"; } 2> /dev/null) || sum=
            if [[ ${sum%% *} != "$DRY_RUN_RC_SHA" ]]; then
                die 1 "$(shown "$RC") changed while tlogger was reading it, so the plan and fingerprint above may not fit it; run the dry run again"
            fi
        fi
        msg "dry run: nothing was written"
        return 0
    fi
    confirm "$(install_question)"
    if (( OPT_REMOVE || OPT_QUARANTINE_SET )) && [[ $RC_STATE != missing ]] &&
        ! cmp -s -- "$OLD_RC" "$RC" 2> /dev/null; then
        die 1 "$(shown "$RC") changed while tlogger was waiting; nothing changed, run it again"
    fi
    install_code
    install_config
    install_state
    if (( OPT_REMOVE || OPT_QUARANTINE_SET )); then
        ensure_dir "$QUARANTINE_DIR" 700
    fi
    if (( OPT_REMOVE )); then
        save_removed_block
    fi
    if (( RC_CHANGED )); then
        write_rc "$WORK/new-rc" prune
    fi
    if (( OPT_REMOVE )); then
        print_undo
    fi
    if (( OPT_QUARANTINE_SET )); then
        move_stale
    fi
    probe_plugin
    print_install_summary
}

# =======================================================
#                        UNINSTALL
# =======================================================

# Parse the uninstall options into OPT_DRY_RUN, OPT_YES and OPT_PURGE_CONFIG.
# Exits 2 on an unknown option; -h and --help print the usage and exit 0.
parse_uninstall_options() {
    while (( $# )); do
        case $1 in
            --dry-run) OPT_DRY_RUN=1; shift ;;
            --yes) OPT_YES=1; shift ;;
            --purge-config) OPT_PURGE_CONFIG=1; shift ;;
            -h | --help) usage; exit 0 ;;
            *) usage_error "unknown option for uninstall: $1" ;;
        esac
    done
}

# Print the uninstall plan on stdout: the change to the rc, what is removed and what stays, then
# the diff of the rc when the block is in it.
print_uninstall_plan() {
    printf 'tlogger uninstall plan\n'
    if (( SCAN_START )); then
        printf '  %-8s %s\n' rc: "$(shown "$RC") (the block at lines $SCAN_START-$SCAN_END is removed)"
    else
        printf '  %-8s %s\n' rc: "$(shown "$RC") (no tlogger block; no change)"
    fi
    printf '  remove:\n'
    print_removals
    if (( ! OPT_PURGE_CONFIG )) && [[ -e $CONFIG_FILE ]]; then
        printf '  %-8s %s\n' keep: "$(shown "$CONFIG_FILE") (pass --purge-config to remove it)"
    fi
    printf '  %-8s %s\n' keep: "$(shown "$STATE_DIR") (logs and rc backups; tlogger never deletes them)"
    if (( SCAN_START )); then
        show_diff strip "$(shown "$RC")" "$(shown "$RC") (new)"
    fi
}

# tlogger uninstall: cut the block out of the rc and remove the code, and with --purge-config
# the config. Never deletes anything in the state folder, and writes nothing anywhere with
# --dry-run. Exits 3 when nothing is installed.
cmd_uninstall() {
    local has_config=0
    parse_uninstall_options "$@"
    refuse_foreign_root
    if (( ! OPT_DRY_RUN )); then
        make_work
    fi
    resolve_paths
    classify_rc
    OLD_RC=
    if [[ $RC_STATE != missing ]]; then
        copy_rc
    fi
    SCAN_START=0 SCAN_END=0
    if [[ -n $OLD_RC ]]; then
        scan_file "$OLD_RC"
        refuse_bad_markers
    fi
    if [[ -f $CONFIG_FILE && ! -L $CONFIG_FILE ]]; then
        has_config=1
    fi
    if (( SCAN_START == 0 )) && ! code_present && ! (( OPT_PURGE_CONFIG && has_config )); then
        msg "not installed: there is no tlogger block in $(shown "$RC") and no tlogger code; nothing to remove"
        exit 3
    fi
    if (( SCAN_START )) && [[ $RC_STATE == foreign ]]; then
        msg "$(shown "$RC") $RC_WHY, so tlogger does not edit it."
        die 1 "remove lines $SCAN_START-$SCAN_END, the tlogger block, from the file by hand (for a symlink, the file it points to), then run tlogger uninstall again; nothing changed"
    fi
    if (( ! OPT_DRY_RUN && ! OPT_YES )) && ! on_tty; then
        die 2 "--yes is required when not run from a terminal"
    fi
    # A symlinked data folder would lead the MANIFEST removals outside it.
    check_dir_safe "$DATA_DIR"
    check_dir_safe "$RELEASES_DIR"
    check_dir_safe "$STATE_DIR"
    check_dir_safe "$BACKUP_DIR"
    if (( OPT_PURGE_CONFIG )); then
        check_dir_safe "$CONFIG_DIR"
    fi
    if (( SCAN_START )); then
        if (( ! OPT_DRY_RUN )); then
            build_rc strip
        fi
        check_syntax strip
    fi
    print_uninstall_plan
    if (( OPT_DRY_RUN )); then
        msg "dry run: nothing was written"
        return 0
    fi
    confirm "Remove tlogger from $(shown "$RC") and delete its code?"
    if (( SCAN_START )); then
        make_parent "$STATE_HOME"
        ensure_dir "$STATE_DIR" 700
        ensure_dir "$BACKUP_DIR" 700
        write_rc "$WORK/new-rc" keep
    fi
    remove_code
    if (( OPT_PURGE_CONFIG )); then
        purge_config
    fi
    printf 'tlogger is uninstalled.\n'
    if [[ -n $BACKUP ]]; then
        printf '  %-8s %s\n' backup: "$(shown "$BACKUP")"
    fi
    if (( ! OPT_PURGE_CONFIG )) && [[ -e $CONFIG_FILE ]]; then
        printf '  %-8s %s\n' kept: "$(shown "$CONFIG_FILE")"
    fi
    printf '  %-8s %s\n' kept: "$(shown "$STATE_DIR") (logs and rc backups; delete them by hand when the engagement rules allow it)"
}

# =======================================================
#                          MODE
# =======================================================

# Print a note on stderr when the variable NAME, such as TLOGGER_MODE, is exported and not empty:
# in the terminal that has it, it wins over the config. TAIL, when given, follows after a ;.
note_preset() {
    local name=$1 tail=${2-}
    if [[ -n ${!name-} && ${!name@a} == *x* ]]; then
        msg "note: $name is set, and in this terminal it wins over the config${tail:+; $tail}"
    fi
}

# Print a note on stderr when an exported TLOGGER_MODE is set, which in the terminal that has it
# wins over the config.
note_mode_preset() {
    note_preset TLOGGER_MODE
}

# tlogger mode [auto|manual]: without an argument, print the mode in the config on stdout, manual
# when the config has no mode= line. With one, set it: only the mode= line changes, or one is
# appended, through a temp file in the config folder, mode 0600, and a rename; auto must pass the
# smoke test first. Exits 0 when done or already so, 1 for an unsafe or invalid config or a failed
# smoke test, 2 for a wrong or extra argument and 3 when there is no config.
cmd_mode() {
    local want='' current
    case ${1-} in
        -h | --help) usage; exit 0 ;;
    esac
    if (( $# > 1 )); then
        usage_error "mode takes one argument at most: auto or manual"
    fi
    if (( $# == 1 )); then
        if [[ $1 != auto && $1 != manual ]]; then
            usage_error "mode takes auto or manual, not '$1'"
        fi
        want=$1
    fi
    refuse_foreign_root
    resolve_paths
    check_dir_safe "$CONFIG_DIR"
    if [[ ! -e $CONFIG_FILE && ! -L $CONFIG_FILE ]]; then
        die 3 "tlogger is not installed; run tlogger install"
    fi
    read_config
    if [[ -n $CONFIG_ERROR ]]; then
        die 1 "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; fix it by hand"
    fi
    current=${CONFIG_MODE:-manual}
    if [[ -z $want ]]; then
        printf '%s\n' "$current"
        note_mode_preset
        return 0
    fi
    if [[ $want == "$current" ]]; then
        msg "mode is already $want"
        note_mode_preset
        return 0
    fi
    if [[ $want == auto ]]; then
        require_working_recorder "keep manual mode, or fix script"
    fi
    make_work
    # Through a file, not a pipe, so that replace_config runs in this shell and cleanup knows its
    # temp file.
    { config_with mode "$want" > "$WORK/config"; } 2> /dev/null ||
        die 1 "cannot copy $(shown "$CONFIG_FILE") to the temp folder"
    replace_config < "$WORK/config"
    if [[ $want == auto ]]; then
        msg "mode is now auto; new terminals record themselves"
    else
        msg "mode is now manual; tlogger start records a terminal"
    fi
    note_mode_preset
}

# =======================================================
#                       ENGAGEMENT
# =======================================================

# tlogger engagement [NAME | --none]: without an argument, print the engagement in the config on
# stdout, none when it has none. With NAME, set it, and with --none clear it, as engagement=: only
# the engagement= line changes, or one is appended, through a temp file in the config folder,
# mode 0600, and a rename, as tlogger mode does. Creates no folder: the first recording in the
# engagement makes it. Refuses every config error but an invalid engagement, which a new value
# replaces and only the printing form refuses. Exits 0 when done or already so, 1 for an unsafe
# or invalid config, 2 for a bad name or a usage error and 3 when there is no config.
cmd_engagement() {
    local want='' current logdir
    local -i change=0
    case ${1-} in
        -h | --help) usage; exit 0 ;;
    esac
    if (( $# > 1 )); then
        usage_error "engagement takes one argument at most: a name or --none"
    fi
    if (( $# == 1 )); then
        change=1
        case $1 in
            --none) ;;
            -?*) usage_error "unknown option for engagement: $1" ;;
            *)
                if ! engagement_name_ok "$1"; then
                    die 2 "'$1' is not a valid engagement name; use letters, digits, ., _ and -," \
                        "at most 64 characters, starting with a letter or a digit, and not" \
                        "MANIFEST or a session id"
                fi
                want=$1
                ;;
        esac
    fi
    refuse_foreign_root
    resolve_paths
    check_dir_safe "$CONFIG_DIR"
    if [[ ! -e $CONFIG_FILE && ! -L $CONFIG_FILE ]]; then
        die 3 "tlogger is not installed; run tlogger install"
    fi
    read_config
    if [[ -n $CONFIG_ERROR ]] && (( ! (change && CONFIG_ENGAGEMENT_BAD) )); then
        if (( CONFIG_ENGAGEMENT_BAD )); then
            die 1 "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; set another one with" \
                "tlogger engagement NAME, or clear it with tlogger engagement --none"
        fi
        die 1 "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; fix it by hand"
    fi
    current=$CONFIG_ENGAGEMENT
    logdir=${CONFIG_LOGDIR:-$SESSIONS_DIR}
    if (( ! change )); then
        printf '%s\n' "${current:-none}"
        note_preset TLOGGER_ENGAGEMENT
        return 0
    fi
    if (( ! CONFIG_ENGAGEMENT_BAD )) && [[ $want == "$current" ]]; then
        msg "engagement is already ${want:-none}"
        note_preset TLOGGER_ENGAGEMENT
        return 0
    fi
    make_work
    # Through a file, not a pipe, so that replace_config runs in this shell and cleanup knows its
    # temp file.
    { config_with engagement "$want" > "$WORK/config"; } 2> /dev/null ||
        die 1 "cannot copy $(shown "$CONFIG_FILE") to the temp folder"
    replace_config < "$WORK/config"
    if [[ -n $want ]]; then
        msg "engagement is now $want; new sessions go into $(shown "${logdir%/}/$want")"
    else
        msg "engagement is now none; new sessions go into $(shown "$logdir")"
    fi
    note_preset TLOGGER_ENGAGEMENT
}

# =======================================================
#                    STATUS AND VERSION
# =======================================================

# tlogger status: report whether tlogger is installed and where its files are. Exits 0 when the
# block and the plugin are both in place, 3 when neither the block nor the code is there, and 1
# for anything in between, malformed markers or an invalid config. Refuses root on the rule
# install follows, since the zsh query runs the .zshenv of the home it is given.
cmd_status() {
    local block=0 code=0 version=unknown rc_note plugin_note mode_note logdir_note result
    local engagement_note
    case ${1-} in
        -h | --help) usage; exit 0 ;;
    esac
    (( $# == 0 )) || usage_error "status takes no options"
    refuse_foreign_root
    resolve_paths
    SCAN_START=0 SCAN_END=0 SCAN_ERRORS=()
    if [[ -f $RC && -r $RC ]]; then
        scan_file "$RC"
        if (( ${#SCAN_ERRORS[@]} )); then
            rc_note="malformed tlogger markers at lines"
            for result in "${SCAN_ERRORS[@]}"; do
                rc_note+=" ${result##* }"
            done
        elif (( SCAN_START )); then
            block=1
            rc_note="block at lines $SCAN_START-$SCAN_END"
        else
            rc_note="no tlogger block"
        fi
    elif [[ -e $RC || -L $RC ]]; then
        rc_note="not readable as a file"
    else
        rc_note="missing"
    fi
    if code_present; then
        code=1
    fi
    if [[ -f $CURRENT_LINK/VERSION && -r $CURRENT_LINK/VERSION ]]; then
        IFS= read -r version < "$CURRENT_LINK/VERSION" || true
    fi
    plugin_note="not readable"
    if [[ -r $PLUGIN ]]; then
        plugin_note="readable"
    fi
    read_config
    mode_note=${CONFIG_MODE:-unset}
    logdir_note=$(shown "${CONFIG_LOGDIR:-$SESSIONS_DIR}")
    engagement_note=${CONFIG_ENGAGEMENT:-none}
    if [[ -n $CONFIG_ERROR ]]; then
        mode_note="unknown: the config $CONFIG_ERROR"
        engagement_note=unknown
    elif [[ ! -e $CONFIG_FILE ]]; then
        mode_note="unset: there is no config"
        logdir_note="$logdir_note (the default)"
    fi
    if (( block && code )) && [[ $plugin_note == readable && ${#SCAN_ERRORS[@]} -eq 0 && -z $CONFIG_ERROR ]]; then
        result=0
    elif (( ! block && ! code )) && (( ${#SCAN_ERRORS[@]} == 0 )); then
        result=3
    else
        result=1
    fi
    case $result in
        0) printf 'tlogger is installed. In a zsh terminal, tlogger status shows whether that terminal is recorded.\n' ;;
        3) printf 'tlogger is not installed.\n' ;;
        *) printf 'tlogger is installed only in part; run tlogger install to repair it.\n' ;;
    esac
    printf '  %-11s %s\n' \
        version: "$version" \
        rc: "$(shown "$RC") ($rc_note)" \
        plugin: "$(shown "$PLUGIN") ($plugin_note)" \
        mode: "$mode_note" \
        logdir: "$logdir_note" \
        engagement: "$engagement_note" \
        config: "$(shown "$CONFIG_FILE")" \
        state: "$(shown "$STATE_DIR")"
    exit "$result"
}

# tlogger version: print the version of the source tree this file belongs to.
cmd_version() {
    (( $# == 0 )) || usage_error "version takes no options"
    read_version
    printf 'tlogger %s\n' "$VERSION_STR"
}

# =======================================================
#                         DOCTOR
# =======================================================

# Print PATH as a config line logdir_mount=PATH, in the ~ form, noting that the config wants the
# full path when PATH lies under HOME.
mount_hint() {
    local hint
    hint=$(shown "$1")
    if [[ $hint != "$1" ]]; then
        printf 'logdir_mount=%s (with ~ written out as the full path)\n' "$hint"
    else
        printf 'logdir_mount=%s\n' "$hint"
    fi
}

# Set REPLY to the field FIELD of /proc/self/mountinfo or /etc/fstab with its escapes decoded:
# \040 a space, \011 a tab, \012 a newline and \134 a backslash, the last one last.
unescape_mount() {
    local s=$1
    s=${s//\\040/ }
    s=${s//\\011/$'\t'}
    s=${s//\\012/$'\n'}
    REPLY=${s//\\134/\\}
}

# Fill MI_POINT, MI_TYPE, MI_DEV and MI_SOURCE, one entry per row of TLOGGER_PROC/self/mountinfo
# (default /proc), in its order: the mount point and the source decoded, the file system type and
# the MAJ:MIN of the device. Only reads that file. Returns 1 when it cannot be read.
read_mountinfo() {
    local file=${TLOGGER_PROC:-/proc}/self/mountinfo line left type source
    local -a f
    MI_POINT=() MI_TYPE=() MI_DEV=() MI_SOURCE=()
    if [[ ! -f $file || ! -r $file ]]; then
        return 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        left=${line%% - *}
        if [[ $left == "$line" ]]; then
            continue
        fi
        type='' source=''
        read -r -a f <<< "$left" || true
        read -r type source _ <<< "${line#* - }" || true
        if (( ${#f[@]} < 5 )) || [[ -z $type ]]; then
            continue
        fi
        unescape_mount "${f[4]}"
        MI_POINT+=("$REPLY")
        MI_TYPE+=("$type")
        MI_DEV+=("${f[2]}")
        unescape_mount "$source"
        MI_SOURCE+=("$REPLY")
    done < "$file"
}

# Set ROW to the mountinfo row whose mount point is the longest prefix of PATH, ending at a /;
# the last one when two tie, as the later mount covers the earlier. -1 when none is.
mount_row_of() {
    local path=$1 point i
    local -i len=-1
    ROW=-1
    for i in "${!MI_POINT[@]}"; do
        point=${MI_POINT[i]}
        if [[ $point == / || $path == "$point" || $path == "$point"/* ]] &&
            (( ${#point} >= len )); then
            ROW=$i len=${#point}
        fi
    done
}

# Succeed when the file system type TYPE keeps its files on another host.
network_type() {
    case $1 in
        nfs | nfs4 | cifs | smb3 | fuse.sshfs) return 0 ;;
    esac
    return 1
}

# Run COMMAND with its arguments, under timeout 5 when NET is 1: on a network file system that
# no longer answers, a command that touches a path would hang.
doctor_tool() {
    local net=$1
    shift
    if (( net )); then
        timeout 5 "$@"
    else
        "$@"
    fi
}

# Set PLACE_REAL, PLACE_ROW, PLACE_AUTOFS and PLACE_NET for the folder PATH: its real path, with
# every symlink of the part that exists resolved, the mountinfo row it lies on, 1 when that row
# is an automount point not mounted yet, and 1 when it is a network file system.
# The path is resolved one part at a time, by readlink on each symlink, up to 40 of them, and
# readlink -m on the result. A part that lies on an automount point not mounted yet, as written
# or reached through a symlink, ends it, with the rest kept as written: looking into that point
# would mount it, and for LUKS could ask for a passphrase. On a network file system, a part is
# only looked at under timeout.
doctor_place() {
    local rest=$1 cur=/ next part target real tail=''
    local -i links=0 net link
    PLACE_AUTOFS=0 PLACE_NET=0 PLACE_ROW=-1
    while [[ -n $rest ]]; do
        part=${rest%%/*}
        if [[ $rest == */* ]]; then
            rest=${rest#*/}
        else
            rest=
        fi
        case $part in
            '' | .) continue ;;
            ..)
                # cur holds no symlink, so .. is its parent as written.
                cur=${cur%/*}
                cur=${cur:-/}
                continue
                ;;
        esac
        next=${cur%/}/$part
        # The rest as written: a deeper mount that holds it, as a key of an indirect automount
        # map that is mounted, lets doctor look at next.
        mount_row_of "$next${rest:+/$rest}"
        if (( ROW >= 0 )) && [[ ${MI_TYPE[ROW]} == autofs && ${MI_POINT[ROW]} != / ]]; then
            tail=$part${rest:+/$rest}
            break
        fi
        mount_row_of "$next"
        net=0 link=0
        if (( ROW >= 0 )) && network_type "${MI_TYPE[ROW]}"; then
            net=1
            if doctor_tool 1 test -L "$next" 2> /dev/null; then
                link=1
            fi
        elif [[ -L $next ]]; then
            link=1
        fi
        if (( link )); then
            if (( links == 40 )); then
                tail=$part${rest:+/$rest}
                break
            fi
            target=$(doctor_tool "$net" readlink -- "$next" 2> /dev/null) || target=
            if [[ -n $target ]]; then
                links+=1
                if [[ $target == /* ]]; then
                    cur=/
                fi
                rest=$target${rest:+/$rest}
                continue
            fi
        fi
        cur=$next
    done
    mount_row_of "$cur"
    net=0
    if (( ROW >= 0 )) && network_type "${MI_TYPE[ROW]}"; then
        net=1
    fi
    real=$(doctor_tool "$net" readlink -m -- "$cur" 2> /dev/null) || real=
    cur=${real:-$cur}
    if [[ -n $tail ]]; then
        PLACE_REAL=${cur%/}/$tail
    else
        PLACE_REAL=$cur
    fi
    mount_row_of "$PLACE_REAL"
    PLACE_ROW=$ROW
    if (( ROW >= 0 )) && [[ ${MI_TYPE[ROW]} == autofs ]]; then
        PLACE_AUTOFS=1
    elif (( ROW >= 0 )) && network_type "${MI_TYPE[ROW]}"; then
        PLACE_NET=1
    fi
}

# Print one check line of doctor: VERDICT (ok, warn or unknown), CHECK and TEXT, the further
# arguments joined by spaces, and count the warnings and unknowns in DOCTOR_WARN and
# DOCTOR_UNKNOWN.
doctor_line() {
    local verdict=$1 check=$2
    shift 2
    printf '  %-8s %-12s %s\n' "$verdict" "$check" "$*"
    case $verdict in
        warn) DOCTOR_WARN+=1 ;;
        unknown) DOCTOR_UNKNOWN+=1 ;;
    esac
}

# Set REPLY to the deepest mount point in TLOGGER_FSTAB (default /etc/fstab) at or above one of
# the PATHs, when mountinfo shows it not mounted, or to nothing: a deeper entry that is mounted
# holds the PATHs, whatever is not mounted above it. / and entries that are no path, such as
# swap, do not count.
fstab_unmounted() {
    local file=${TLOGGER_FSTAB:-/etc/fstab} spec point path i best=''
    local -i mounted best_mounted=0
    if [[ -f $file && -r $file ]]; then
        while read -r spec point _; do
            if [[ -z $spec || $spec == '#'* ]]; then
                continue
            fi
            unescape_mount "${point-}"
            point=$REPLY
            while [[ $point == */ && $point != / ]]; do
                point=${point%/}
            done
            if [[ $point != /* || $point == / || ${#point} -le ${#best} ]]; then
                continue
            fi
            for path in "$@"; do
                if [[ $path == "$point" || $path == "$point"/* ]]; then
                    mounted=0
                    for i in "${!MI_POINT[@]}"; do
                        if [[ ${MI_POINT[i]} == "$point" && ${MI_TYPE[i]} != autofs ]]; then
                            mounted=1
                        fi
                    done
                    best=$point best_mounted=$mounted
                    break
                fi
            done
        done < "$file"
    fi
    if (( best_mounted )); then
        best=
    fi
    REPLY=$best
}

# Set REPLY, for the log folder DIR on a volume that is not mounted, to a note on what already
# lies there on the disk beneath: its number of entries, or nothing when it is no folder. Lists
# the folder and reads none of its files. Nothing when doctor_place found the folder on an
# automount point not mounted yet, which the listing would mount, or on a network file system,
# where it could hang.
shadow_note() {
    local e
    local -i n=0
    REPLY=
    if (( PLACE_AUTOFS || PLACE_NET )); then
        return 0
    fi
    if [[ -d $1 && ! -L $1 ]]; then
        for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
            if [[ -e $e || -L $e ]]; then
                n+=1
            fi
        done
        REPLY="; the log folder already exists on the disk beneath it, with $n"
        if (( n == 1 )); then
            REPLY+=" entry"
        else
            REPLY+=" entries"
        fi
        REPLY+=", which the volume hides once it is mounted"
    fi
}

# Print the volume check of the log folder LOGDIR, placed by doctor_place, for the logdir_mount
# MOUNT, empty for none. Sets MOUNT_OK to 1 when MOUNT is mounted and holds LOGDIR as written,
# which is how the guard at the start of a recording compares them.
doctor_volume() {
    local logdir=$1 mount=$2 point i text
    local -i row=-1
    MOUNT_OK=0
    if [[ -n $mount ]]; then
        for i in "${!MI_POINT[@]}"; do
            if [[ ${MI_POINT[i]} == "$mount" ]]; then
                row=$i
            fi
        done
        text="the volume $(shown "$mount") that logdir_mount names"
        if (( row < 0 )); then
            shadow_note "$logdir"
            doctor_line warn volume "$text is not mounted; mount it before you record$REPLY"
            return 0
        fi
        if [[ ${MI_TYPE[row]} == autofs ]]; then
            text+=" is an automount point that is not mounted yet; open it, then run tlogger"
            doctor_line warn volume "$text doctor again"
            return 0
        fi
        if [[ $logdir != "$mount" && $logdir != "${mount%/}"/* ]]; then
            text="the log folder does not lie on $text, so a recording refuses; fix logdir or"
            doctor_line warn volume "$text logdir_mount"
            return 0
        fi
        MOUNT_OK=1
    fi
    if (( PLACE_ROW < 0 )); then
        text="no row of /proc/self/mountinfo holds the log folder; check by hand that its volume"
        doctor_line unknown volume "$text is mounted"
        return 0
    fi
    point=${MI_POINT[PLACE_ROW]}
    if (( PLACE_AUTOFS )); then
        text="the log folder lies on the automount point $(shown "$point"), which is not mounted"
        doctor_line warn volume "$text yet; open it, then run tlogger doctor again"
    elif [[ -n $mount ]]; then
        # The guard only checks logdir_mount: a deeper volume between it and the log folder is
        # not guarded.
        fstab_unmounted "$logdir" "$PLACE_REAL"
        if [[ -n $REPLY && $REPLY != "$mount" && $REPLY == "${mount%/}"/* ]]; then
            point=$REPLY
            shadow_note "$logdir"
            text="the fstab entry $(shown "$point") between logdir_mount and the log folder is"
            text+=" not mounted; mount it, and change the config to $(mount_hint "$point"), so"
            doctor_line warn volume "$text that a recording refuses while it is not mounted$REPLY"
        elif [[ $point != "$mount" ]]; then
            text="the log folder lies on $(shown "$point"), another volume than the one that"
            if [[ $point == "${mount%/}"/* ]]; then
                text+=" logdir_mount names, which it does not guard; change the config to"
                doctor_line warn volume "$text $(mount_hint "$point")"
            else
                text+=" logdir_mount names, which it does not guard; fix logdir or logdir_mount"
                doctor_line warn volume "$text"
            fi
        else
            doctor_line ok volume "on $(shown "$mount"), which logdir_mount names, mounted"
        fi
    else
        fstab_unmounted "$logdir" "$PLACE_REAL"
        if [[ -n $REPLY ]]; then
            point=$REPLY
            shadow_note "$logdir"
            text="the fstab entry $(shown "$point") at or above the log folder is not mounted;"
            text+=" mount it, and add $(mount_hint "$point") to the config, so that a recording"
            doctor_line warn volume "$text refuses while it is not mounted$REPLY"
        elif [[ $point != / ]]; then
            text="on $(shown "$point"), a volume of its own; add $(mount_hint "$point") to the"
            doctor_line warn volume "$text config, so that a recording refuses while it is not" \
                "mounted"
        else
            doctor_line ok volume "on /, no unmounted fstab entry at or above the log folder"
        fi
    fi
}

# Print the volume check of an engagement folder that lies on another mount than the log folder:
# logdir_mount does not guard it.
doctor_engagement_volume() {
    local text
    if (( PLACE_ROW < 0 )); then
        text="no row of /proc/self/mountinfo holds the engagement folder; check by hand that its"
        doctor_line unknown volume "$text volume is mounted"
        return 0
    fi
    text="the engagement folder lies on"
    if (( PLACE_AUTOFS )); then
        text+=" the automount point $(shown "${MI_POINT[PLACE_ROW]}"), which is not mounted yet;"
        doctor_line warn volume "$text open it, then run tlogger doctor again"
    else
        text+=" a volume of its own, $(shown "${MI_POINT[PLACE_ROW]}"), which logdir_mount does"
        doctor_line warn volume "$text not guard; keep it on the volume of the log folder"
    fi
}

# Print the line of the check CHECK that would have to look into an automount point that is not
# mounted yet.
doctor_not_yet() {
    local text="the volume is not mounted yet (automount), and doctor does not look into it;"
    doctor_line unknown "$1" "$text open it, then run tlogger doctor again"
}

# Print the folder check of DIR, placed by doctor_place: it must be a real folder of this user's,
# not a symlink, with no group or other bits in its mode. A missing DIR is ok when CREATE is 1,
# as the first recording creates it, else a warning. One stat names DIR, under timeout on a
# network file system; it changes nothing.
doctor_folder() {
    local dir=$1 info hex uid mode
    local -i create=$2 rc=0 kind
    if (( PLACE_AUTOFS )); then
        doctor_not_yet folder
        return 0
    fi
    info=$(doctor_tool "$PLACE_NET" stat -c '%f %u %a' -- "$dir" 2> /dev/null) || rc=$?
    if (( rc == 124 )); then
        doctor_line unknown folder "its network file system did not answer within 5 seconds"
        return 0
    fi
    if (( rc != 0 )); then
        if doctor_tool "$PLACE_NET" test -e "$dir" || doctor_tool "$PLACE_NET" test -L "$dir"
        then
            doctor_line unknown folder "doctor cannot look at it; check its owner and mode by hand"
        elif (( create )); then
            doctor_line ok folder "does not exist yet; the first recording creates it, mode 700"
        else
            doctor_line warn folder "does not exist yet; a recording refuses until you create it" \
                "or mount its volume"
        fi
        return 0
    fi
    read -r hex uid mode <<< "$info" || true
    if [[ ! $hex =~ ^[0-9a-f]+$ || ! $uid =~ ^[0-9]+$ || ! $mode =~ ^[0-7]+$ ]]; then
        doctor_line unknown folder "doctor cannot read its mode; check its owner and mode by hand"
        return 0
    fi
    kind=$(( 16#$hex & 16#F000 ))
    if (( kind == 16#A000 )); then
        doctor_line warn folder "is a symlink, which a recording refuses; name the real folder"
    elif (( kind != 16#4000 )); then
        doctor_line warn folder "is not a folder"
    elif (( uid != EUID )); then
        doctor_line warn folder "belongs to another user"
    elif (( 8#$mode & 8#077 )); then
        doctor_line warn folder "exists, yours, mode $mode: its group or others may enter it;" \
            "chmod 700 $(shown "$dir") makes it private"
    else
        doctor_line ok folder "exists, yours, mode $mode"
    fi
}

# Print the permissions check of the file system that doctor_place found: a type that ignores
# Unix modes, or that another machine reads freely, is a warning.
doctor_permissions() {
    local type
    if (( PLACE_AUTOFS )); then
        doctor_not_yet permissions
        return 0
    fi
    if (( PLACE_ROW < 0 )); then
        doctor_line unknown permissions "no row of /proc/self/mountinfo holds it; check its file" \
            "system by hand"
        return 0
    fi
    type=${MI_TYPE[PLACE_ROW]}
    case $type in
        vfat | msdos | exfat | ntfs | ntfs3 | fuseblk | vboxsf | 9p | drvfs | virtiofs | \
            fuse.vmhgfs-fuse | cifs | smb3)
            doctor_line warn permissions "$type does not keep Unix permissions: modes 700 and" \
                "600 mean nothing there, and another machine reads the medium freely"
            ;;
        fuse.gocryptfs | fuse.cryfs | fuse.encfs | fuse.securefs | fuse.sshfs)
            doctor_line ok permissions "$type keeps Unix permissions"
            ;;
        fuse.*)
            doctor_line unknown permissions "$type may not keep Unix permissions; check by hand" \
                "that mode 700 holds there"
            ;;
        *)
            doctor_line ok permissions "$type keeps Unix permissions"
            ;;
    esac
}

# Follow the block device folder DIR of sysfs down to the disks: each dm/uuid and every branch of
# slaves/. A branch ends at an encryption layer, which goes into WALK_CRYPT, or at a device
# without slaves, which goes into WALK_PLAIN when it is a real disk and into WALK_OTHER when it
# is virtual, such as a loop device. Every other layer on the way goes into WALK_LAYERS. Only
# reads sysfs; DEPTH stops a loop.
walk_device() {
    local dir=$1 real uuid='' slave
    local -i depth=$2
    local -a slaves=()
    real=$(readlink -f -- "$dir" 2> /dev/null) || real=$dir
    if (( depth > 16 )); then
        WALK_OTHER+=("${real##*/}")
        return 0
    fi
    if [[ -f $real/dm/uuid && -r $real/dm/uuid ]]; then
        IFS= read -r uuid < "$real/dm/uuid" || true
    fi
    case $uuid in
        CRYPT-LUKS1-*) WALK_CRYPT+=(LUKS1); return 0 ;;
        CRYPT-LUKS2-*) WALK_CRYPT+=(LUKS2); return 0 ;;
        CRYPT-PLAIN-*) WALK_CRYPT+=("plain dm-crypt"); return 0 ;;
        CRYPT-LOOPAES-*) WALK_CRYPT+=(loop-AES); return 0 ;;
        CRYPT-TCRYPT-*) WALK_CRYPT+=(TrueCrypt); return 0 ;;
        CRYPT-BITLK-*) WALK_CRYPT+=(BitLocker); return 0 ;;
        CRYPT-FVAULT2-*) WALK_CRYPT+=("FileVault 2"); return 0 ;;
        CRYPT-VERITY-*) WALK_LAYERS+=(dm-verity) ;;
        CRYPT-INTEGRITY-*) WALK_LAYERS+=(dm-integrity) ;;
        CRYPT-*) WALK_LAYERS+=(dm-crypt) ;;
        LVM-*) WALK_LAYERS+=(LVM) ;;
        mpath-*) WALK_LAYERS+=(multipath) ;;
        ?*) WALK_LAYERS+=(device-mapper) ;;
    esac
    if [[ -d $real/md ]]; then
        WALK_LAYERS+=(RAID)
    fi
    for slave in "$real"/slaves/*; do
        if [[ -e $slave ]]; then
            slaves+=("$slave")
        fi
    done
    if (( ${#slaves[@]} == 0 )); then
        if [[ $real == */devices/virtual/* ]]; then
            WALK_OTHER+=("${real##*/}")
        else
            WALK_PLAIN+=("${real##*/}")
        fi
        return 0
    fi
    for slave in "${slaves[@]}"; do
        walk_device "$slave" "$(( depth + 1 ))"
    done
}

# Print the words given, each once, in their order, joined by ', '.
join_unique() {
    local word out=''
    local -A seen=()
    for word in "$@"; do
        if [[ -z ${seen[$word]+set} ]]; then
            seen[$word]=1
            out+="${out:+, }$word"
        fi
    done
    printf '%s\n' "$out"
}

# Print the encryption check of the file system that doctor_place found for the folder DIR: an
# encrypting file system type passes; memory and other hosts are a warning; a disk-backed file
# system passes when every branch below it reaches an encryption layer before a disk, and is a
# warning when one reaches a disk without one. What doctor cannot see is unknown, with what to
# check by hand.
doctor_encryption() {
    local dir=$1 type dev majmin source sysfs=${TLOGGER_SYSFS:-/sys} text
    if (( PLACE_AUTOFS )); then
        doctor_not_yet encryption
        return 0
    fi
    if (( PLACE_ROW < 0 )); then
        doctor_line unknown encryption "no row of /proc/self/mountinfo holds it; check by hand" \
            "that its storage is encrypted"
        return 0
    fi
    type=${MI_TYPE[PLACE_ROW]} majmin=${MI_DEV[PLACE_ROW]} source=${MI_SOURCE[PLACE_ROW]}
    case $type in
        ecryptfs | fuse.gocryptfs | fuse.cryfs | fuse.encfs | fuse.securefs)
            doctor_line ok encryption "$type encrypts the files"
            return 0
            ;;
        tmpfs | ramfs)
            doctor_line warn encryption "$type keeps the logs in memory only, and a reboot loses" \
                "them"
            return 0
            ;;
        nfs | nfs4 | cifs | smb3 | fuse.sshfs)
            doctor_line warn encryption "$type keeps the logs on another host, whose storage" \
                "doctor cannot see"
            return 0
            ;;
        overlay)
            doctor_line unknown encryption "overlay, as in Kali Live persistence or a container;" \
                "check by hand that the storage beneath it is encrypted"
            return 0
            ;;
        zfs)
            doctor_line unknown encryption "zfs; check its own encryption by hand, with zfs get" \
                "encryption"
            return 0
            ;;
    esac
    if [[ $majmin == 0:* && $type == btrfs && $source == /dev/* ]]; then
        # btrfs reports a device number of its own; its source names the block device.
        dev=$(readlink -f -- "$source" 2> /dev/null) || dev=
        majmin=
        if [[ $dev == /dev/* && -f $sysfs/class/block/${dev##*/}/dev ]]; then
            IFS= read -r majmin < "$sysfs/class/block/${dev##*/}/dev" || true
        fi
    fi
    if [[ ! $majmin =~ ^[0-9]+:[0-9]+$ || $majmin == 0:* ]]; then
        doctor_line unknown encryption "$type lies on no block device that doctor can follow;" \
            "check by hand that its storage is encrypted"
        return 0
    fi
    if [[ ! -e $sysfs/dev/block/$majmin ]]; then
        doctor_line unknown encryption "/sys/dev/block/$majmin is missing, as in a container;" \
            "check by hand that the storage beneath $type is encrypted"
        return 0
    fi
    WALK_CRYPT=() WALK_LAYERS=() WALK_PLAIN=() WALK_OTHER=()
    walk_device "$sysfs/dev/block/$majmin" 0
    if (( ${#WALK_PLAIN[@]} )); then
        text="no encryption found above $(join_unique "${WALK_PLAIN[@]}"); doctor cannot see"
        text+=" the host's disk encryption when Kali runs in a virtual machine, a self-encrypting"
        doctor_line warn encryption "$text drive, or fscrypt (check by hand with lsattr -d" \
            "$(shown "$dir"))"
    elif (( ${#WALK_OTHER[@]} )); then
        doctor_line unknown encryption "$(join_unique "${WALK_OTHER[@]}") is a virtual device," \
            "such as a loop device, that doctor cannot follow; check by hand that its storage" \
            "is encrypted"
    elif (( ${#WALK_CRYPT[@]} )); then
        text=$(join_unique "${WALK_CRYPT[@]}")
        if (( ${#WALK_LAYERS[@]} )); then
            text+=", under $(join_unique "${WALK_LAYERS[@]}")"
        fi
        doctor_line ok encryption "$text"
    else
        doctor_line unknown encryption "doctor found no disk below $type; check by hand that" \
            "its storage is encrypted"
    fi
}

# tlogger doctor: check, and change nothing, the log folder of the config and, with an
# engagement, its engagement folder: whether the volume that holds it is mounted, whether the
# folder is a private real folder of this user's, whether its file system keeps Unix permissions
# and whether its storage is encrypted. Prints one line per check, ok, warn or unknown, and a
# last line. Reads TLOGGER_PROC/self/mountinfo, TLOGGER_SYSFS, TLOGGER_FSTAB and folder modes,
# and runs only readlink, stat and timeout, found through PATH, and no root tool. It touches
# nothing on an automount point that is not mounted yet, and runs every command that touches a
# path on a network file system under timeout 5. A config error is a warning, and the default
# log folder is checked instead. Exits 0 when every check is ok, 1 on any warn or unknown, 2 on
# a usage error.
cmd_doctor() {
    local logdir mount='' engagement='' dir summary
    local -i log_row create=0 eng_create=0
    case ${1-} in
        -h | --help) usage; exit 0 ;;
    esac
    (( $# == 0 )) || usage_error "doctor takes no options"
    refuse_foreign_root
    resolve_paths
    read_config
    for dir in TLOGGER_LOGDIR TLOGGER_LOGDIR_MOUNT TLOGGER_ENGAGEMENT; do
        note_preset "$dir" "doctor checked the config's value"
    done
    logdir=$SESSIONS_DIR
    if [[ -z $CONFIG_ERROR ]]; then
        logdir=${CONFIG_LOGDIR:-$SESSIONS_DIR}
        mount=$CONFIG_LOGDIR_MOUNT engagement=$CONFIG_ENGAGEMENT
    fi
    DOCTOR_WARN=0 DOCTOR_UNKNOWN=0
    read_mountinfo || true
    printf 'tlogger doctor: %s\n' "$(shown "$logdir")"
    if [[ -n $CONFIG_ERROR ]]; then
        doctor_line warn config "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; doctor" \
            "checked the default log folder"
    fi
    doctor_place "$logdir"
    log_row=$PLACE_ROW
    doctor_volume "$logdir" "$mount"
    # A recording creates a missing log folder only when it is the default, or when it lies on
    # the mounted volume of logdir_mount.
    if [[ -n $mount ]]; then
        create=$MOUNT_OK
    elif [[ $logdir == "$SESSIONS_DIR" ]]; then
        create=1
    fi
    doctor_folder "$logdir" "$create"
    # The first recording creates a missing engagement folder only in a log folder that is there
    # already, without logdir_mount, or that it creates itself.
    eng_create=$create
    if [[ -z $mount ]] && (( ! create && ! PLACE_AUTOFS )) &&
        doctor_tool "$PLACE_NET" test -d "$logdir" && ! doctor_tool "$PLACE_NET" test -L "$logdir"
    then
        eng_create=1
    fi
    doctor_permissions
    doctor_encryption "$logdir"
    if [[ -n $CONFIG_ERROR ]]; then
        printf '  %-21s %s\n' engagement "unknown, since the config has an error"
    elif [[ -z $engagement ]]; then
        printf '  %-21s %s\n' engagement "none; new sessions go into the log folder"
    else
        dir=${logdir%/}/$engagement
        printf '  %-21s %s\n' engagement "$engagement; new sessions go into $(shown "$dir")"
        doctor_place "$dir"
        doctor_folder "$dir" "$eng_create"
        if (( PLACE_ROW != log_row )); then
            doctor_engagement_volume
            doctor_permissions
            doctor_encryption "$dir"
        fi
    fi
    if (( DOCTOR_WARN + DOCTOR_UNKNOWN == 0 )); then
        printf 'No warnings. Nothing was changed.\n'
        exit 0
    fi
    summary="$DOCTOR_WARN warnings"
    if (( DOCTOR_WARN == 1 )); then
        summary="1 warning"
    fi
    printf '%s and %s unknown. Nothing was changed.\n' "$summary" "$DOCTOR_UNKNOWN"
    exit 1
}

# =======================================================
#                  RENDER, SHOW AND REPLAY
# =======================================================

# Exit 1 unless DIR is a session folder that tlogger may read: a real folder of this user's, not
# a symlink, holding output.raw and timing as readable regular files of this user's, neither a
# symlink. Messages name DIR in the ~ form.
check_session_dir() {
    local dir=$1 f
    if [[ -L $dir ]]; then
        die 1 "$(shown "$dir") is a symlink, which tlogger does not follow"
    fi
    if [[ ! -e $dir ]]; then
        die 1 "$(shown "$dir") does not exist"
    fi
    if [[ ! -d $dir ]]; then
        die 1 "$(shown "$dir") is not a folder"
    fi
    if [[ ! -O $dir ]]; then
        die 1 "$(shown "$dir") belongs to another user"
    fi
    for f in output.raw timing; do
        if [[ -L $dir/$f ]]; then
            die 1 "$(shown "$dir/$f") is a symlink, which tlogger does not follow"
        fi
        if [[ ! -e $dir/$f ]]; then
            die 1 "$(shown "$dir") holds no $f, so it is not a session folder"
        fi
        if [[ ! -f $dir/$f ]]; then
            die 1 "$(shown "$dir/$f") is not a regular file"
        fi
        if [[ ! -O $dir/$f ]]; then
            die 1 "$(shown "$dir/$f") belongs to another user"
        fi
        if [[ ! -r $dir/$f ]]; then
            die 1 "cannot read $(shown "$dir/$f")"
        fi
    done
}

# Set SESSION_DIR and SESSION_ID from the SESSION argument of render, show and replay. An
# argument with a / is a path to a session folder anywhere, made absolute without resolving
# symlinks, whose last part must be neither '.' nor '..'. Any other argument must be a session
# id, a folder in the log folder or in one of its engagement folders (see find_engagement_dirs);
# none picks the newest session of both levels by name, which starts with the UTC time, among
# the real folders named like sessions. The log folder is the config's logdir, else the default.
# Exits 3 when the log folder is missing or holds no session, 1 for an argument that is no id, an
# id without a folder or with more than one, an unsafe log folder or config, or a folder that
# check_session_dir refuses.
resolve_session() {
    local arg=$1 logdir dir parent
    local -a matches=()
    if [[ $arg == */* ]]; then
        dir=$(strip_slashes "$arg")
        if [[ $dir != /* ]]; then
            dir=${PWD%/}/$dir
        fi
        case ${dir##*/} in
            . | ..) die 1 "name the session folder itself in the path, not . or .." ;;
        esac
        check_session_dir "$dir"
        SESSION_DIR=$dir SESSION_ID=${dir##*/}
        return 0
    fi
    if [[ -n $arg && ! $arg =~ $SESSION_NAME_RE ]]; then
        die 1 "'$arg' is not a session id; name a session folder elsewhere by a path with a /"
    fi
    resolve_logdir
    logdir=$LOGDIR
    if [[ -n $arg ]]; then
        find_engagement_dirs
        for parent in "$logdir" "${ENGAGEMENT_DIRS[@]}"; do
            if [[ -e $parent/$arg || -L $parent/$arg ]]; then
                matches+=("$parent/$arg")
            fi
        done
        if (( ${#matches[@]} == 0 )); then
            die 1 "there is no session $arg in $(shown "$logdir")"
        fi
    else
        collect_sessions
        if (( ${#SESSIONS[@]} == 0 )); then
            die 3 "no sessions in $(shown "$logdir")"
        fi
        # SESSIONS is sorted by id, so copies of the newest id come last.
        arg=${SESSIONS[-1]##*/}
        for dir in "${SESSIONS[@]}"; do
            if [[ ${dir##*/} == "$arg" ]]; then
                matches+=("$dir")
            fi
        done
    fi
    if (( ${#matches[@]} > 1 )); then
        die 1 "session $arg is in more than one folder of $(shown "$logdir"); name the one you" \
            "mean by its path"
    fi
    dir=${matches[0]}
    check_session_dir "$dir"
    SESSION_DIR=$dir SESSION_ID=${dir##*/}
}

# Set LOGDIR to the log folder: the config's logdir, else the default. Exits 3 when it does not
# exist, 1 for an unsafe config or a log folder that is a symlink, no folder or another user's.
resolve_logdir() {
    resolve_paths
    read_config
    if [[ -n $CONFIG_ERROR ]]; then
        die 1 "the config $(shown "$CONFIG_FILE") $CONFIG_ERROR; fix it by hand"
    fi
    LOGDIR=${CONFIG_LOGDIR:-$SESSIONS_DIR}
    if [[ -L $LOGDIR ]]; then
        die 1 "the log folder $(shown "$LOGDIR") is a symlink, which tlogger does not follow"
    fi
    if [[ ! -e $LOGDIR ]]; then
        die 3 "no sessions: the log folder $(shown "$LOGDIR") does not exist"
    fi
    if [[ ! -d $LOGDIR ]]; then
        die 1 "the log folder $(shown "$LOGDIR") is not a folder"
    fi
    if [[ ! -O $LOGDIR ]]; then
        die 1 "the log folder $(shown "$LOGDIR") belongs to another user"
    fi
}

# Set ENGAGEMENT_DIRS to the engagement folders of LOGDIR: its entries with a valid engagement
# name that are real folders of this user's, not symlinks, whether the config names them or
# they were made by hand. Nothing deeper counts.
find_engagement_dirs() {
    local LC_ALL=C entry
    ENGAGEMENT_DIRS=()
    for entry in "$LOGDIR"/*; do
        if engagement_name_ok "${entry##*/}" && [[ -d $entry && ! -L $entry && -O $entry ]]; then
            ENGAGEMENT_DIRS+=("$entry")
        fi
    done
}

# Set SESSIONS to the session folders of LOGDIR and of its engagement folders, the real folders
# named like sessions, by name in byte order, which is time order, whichever folder holds them.
# Copies of one id keep the order of their folders, the log folder first. SESSIONS may be empty.
collect_sessions() {
    # Byte order and byte ranges, so that the locale cannot reorder or widen the names.
    local LC_ALL=C dir entry
    local -a rows=()
    SESSIONS=()
    find_engagement_dirs
    for dir in "$LOGDIR" "${ENGAGEMENT_DIRS[@]}"; do
        for entry in "$dir"/*; do
            if [[ ${entry##*/} =~ $SESSION_NAME_RE && -d $entry && ! -L $entry ]]; then
                rows+=("${entry##*/}"$'\t'"$entry")
            fi
        done
    done
    if (( ${#rows[@]} )); then
        # A session name holds no tab, and no path a newline: read_config and resolve_paths
        # refuse a log folder with one.
        mapfile -t SESSIONS < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -s -t $'\t' -k 1,1 |
            cut -f 2-)
        if (( ${#SESSIONS[@]} != ${#rows[@]} )); then
            die 1 "cannot sort the sessions of $(shown "$LOGDIR")"
        fi
    fi
}

# Set SESSIONS as collect_sessions does. Exits 3 when there is none.
list_sessions() {
    collect_sessions
    if (( ${#SESSIONS[@]} == 0 )); then
        die 3 "no sessions in $(shown "$LOGDIR")"
    fi
}

# Set PYTHON to the interpreter that runs libexec/tlogger_view.py, /usr/bin/python3, run as
# '-I' so that neither the environment, the user site nor the working folder reaches it. Exit 1
# with 'CMD cannot read ...' when that file is missing or unreadable, with 'CMD needs python3'
# unless the interpreter runs the file's probe, and, when WANT is pyte, with
# 'CMD needs python3-pyte (...)' when pyte does not import. TLOGGER_PYTHON, exported and not
# empty, names another interpreter; it exists for the tests, and production never sets it.
require_python() {
    local cmd=$1 want=${2-} out
    local view=$SRC_ROOT/libexec/tlogger_view.py
    local -a probe=(probe)
    if [[ ! -f $view || ! -r $view ]]; then
        die 1 "$cmd cannot read $(shown "$view"); install tlogger again"
    fi
    PYTHON=/usr/bin/python3
    if [[ -n ${TLOGGER_PYTHON-} && ${TLOGGER_PYTHON@a} == *x* ]]; then
        PYTHON=$TLOGGER_PYTHON
    fi
    if [[ $want == pyte ]]; then
        probe+=(--pyte)
    fi
    if [[ ! -f $PYTHON || ! -x $PYTHON ]]; then
        die 1 "$cmd needs python3"
    fi
    out=$("$PYTHON" -I "$SRC_ROOT/libexec/tlogger_view.py" "${probe[@]}" < /dev/null 2> /dev/null) ||
        out=
    case $out in
        ok) ;;
        no-pyte) die 1 "$cmd needs python3-pyte (apt install python3-pyte)" ;;
        *) die 1 "$cmd needs python3" ;;
    esac
}

# Set SCRIPTREPLAY to util-linux scriptreplay, /usr/bin/scriptreplay, and exit 1 when it is
# missing or not executable. TLOGGER_SCRIPTREPLAY, exported and not empty, names another one; it
# exists for the tests, and production never sets it.
require_scriptreplay() {
    SCRIPTREPLAY=/usr/bin/scriptreplay
    if [[ -n ${TLOGGER_SCRIPTREPLAY-} && ${TLOGGER_SCRIPTREPLAY@a} == *x* ]]; then
        SCRIPTREPLAY=$TLOGGER_SCRIPTREPLAY
    fi
    if [[ ! -f $SCRIPTREPLAY || ! -x $SCRIPTREPLAY ]]; then
        die 1 "replay needs scriptreplay, from util-linux"
    fi
}

# Render the transcript of SESSION_DIR with libexec/tlogger_view.py: into transcript.txt there,
# or with TO set to stdout, onto stdout. Needs PYTHON and VERSION_STR. The Python code prints its
# own messages; when it fails, this exits with its status.
run_render() {
    local to=${1-} status=0
    local -a opts=(--version "$VERSION_STR")
    if [[ $to == stdout ]]; then
        opts+=(--stdout)
    fi
    "$PYTHON" -I "$SRC_ROOT/libexec/tlogger_view.py" render "${opts[@]}" -- "$SESSION_DIR" \
        < /dev/null || status=$?
    if (( status )); then
        exit "$status"
    fi
}

# Succeed when SESSION_DIR/transcript.txt is a readable regular file of this user's, not a
# symlink, newer than output.raw and timing, with the header line that render writes for this
# session and no control byte but LF and HT, so that show can page it as it is. The file sits in
# a folder that a crafted session may have filled, so show prints it only when it looks like
# render's own: valid UTF-8, with no NUL or other C0 byte, no DEL and no C1 control (C2 80 to
# C2 9F). Without iconv the file counts as untrusted and is rendered again.
transcript_fresh() {
    local t=$SESSION_DIR/transcript.txt
    local LC_ALL=C first chunk carry=''
    [[ -f $t && ! -L $t && -O $t && -r $t && $t -nt $SESSION_DIR/output.raw &&
        $t -nt $SESSION_DIR/timing ]] || return 1
    IFS= read -r -n 512 first < "$t" || [[ -n $first ]] || return 1
    [[ $first == "# DERIVED transcript of session $SESSION_ID; the evidence is output.raw with timing."* ]] ||
        return 1
    # tr deletes the bytes allowed; any byte left is a control byte.
    (( $(LC_ALL=C tr -d '\11\12\40-\176\200-\377' < "$t" | head -c 1 | wc -c) == 0 )) || return 1
    # render writes only valid UTF-8, so a raw byte such as 0x9B cannot come from it.
    iconv -f UTF-8 -t UTF-8 < "$t" > /dev/null 2>&1 || return 1
    # A chunk is checked with the last byte of the one before, so that no pair is split.
    while IFS= read -r -N 65536 chunk || [[ -n $chunk ]]; do
        if [[ $carry$chunk == *$'\xc2'[$'\x80'-$'\x9f']* ]]; then
            return 1
        fi
        carry=${chunk: -1}
    done < "$t"
}

# Succeed when VALUE is a positive decimal number of at most 20 characters: DECIMAL_RE, with a
# digit other than 0 in it.
positive_decimal() {
    [[ ${#1} -le 20 && $1 =~ $DECIMAL_RE && $1 == *[1-9]* ]]
}

# Put back the terminal settings that replay changed, if any, then discard the keys still queued:
# scriptreplay leaves those it has not read, and the shell would run them as a command. Ignores
# every failure, so that cleanup can call it at any time.
restore_tty() {
    if [[ -n $TTY_SAVED ]]; then
        stty "$TTY_SAVED" < /dev/tty > /dev/null 2>&1 || true
        "$PYTHON" -I -c 'import termios; termios.tcflush(0, termios.TCIFLUSH)' \
            2> /dev/null < /dev/tty > /dev/null || true
        TTY_SAVED=
    fi
}

# Run SCRIPTREPLAY with the arguments given, its stdout piped through the filter of
# tlogger_view.py, and exit unless both succeed: with the filter's status, or 1 after
# scriptreplay's messages, home paths shown as ~. scriptreplay sets raw mode only on a terminal
# stdout, which a pipe is not, so on a terminal its keys come from a new open of /dev/tty in
# non-canonical mode without echo, and the O_NONBLOCK it sets on its stdin, which it puts back
# only on a terminal stdout, stays off the shell's own terminal file. Without a stdin terminal
# and a /dev/tty that opens, it reads /dev/null, never a stdin it may share with the calling
# shell. Needs WORK for scriptreplay's messages; restore_tty undoes the stty and drops queued keys.
# bash and scriptreplay ignore SIGTSTP during the pipeline, so that Ctrl+Z stops nothing until the
# filter has restored the terminal. A SIGTSTP that was ignored when tlogger started stays ignored.
replay_through_filter() {
    local -i tty=0 replay filter
    local -a codes suspend=()
    local line home
    if [[ -t 0 ]] && { : < /dev/tty; } 2> /dev/null; then
        exec {tty}< /dev/tty
        TTY_SAVED=$(stty -g <&"$tty" 2> /dev/null) || TTY_SAVED=
        if [[ -n $TTY_SAVED ]]; then
            if [[ -z $(trap -p TSTP) ]]; then
                trap '' TSTP
                suspend=(--suspend "$TTY_SAVED")
            fi
            stty -icanon -echo min 1 time 0 <&"$tty" 2> /dev/null || true
        fi
        msg "replaying session $SESSION_ID: Space pauses, Up and Down change the speed, Ctrl+C stops"
    else
        exec {tty}< /dev/null
    fi
    if "$SCRIPTREPLAY" "$@" <&"$tty" 2> "$WORK/scriptreplay.err" |
        "$PYTHON" -I "$SRC_ROOT/libexec/tlogger_view.py" filter "${suspend[@]}"; then
        codes=("${PIPESTATUS[@]}")
    else
        codes=("${PIPESTATUS[@]}")
    fi
    restore_tty
    if (( ${#suspend[@]} )); then
        trap - TSTP
    fi
    if (( tty )); then
        exec {tty}<&-
    fi
    replay=${codes[0]:-1} filter=${codes[1]:-1}
    if (( filter )); then
        exit "$filter"
    fi
    if (( replay )); then
        home=$(strip_slashes "${HOME-}")
        while IFS= read -r line; do
            if [[ -n $home && $home != / ]]; then
                line=${line//"$home/"/\~/}
            fi
            msg "scriptreplay: $line"
        done < "$WORK/scriptreplay.err"
        die 1 "the replay of session $SESSION_ID failed: scriptreplay exited with status $replay"
    fi
}

# tlogger render [--stdout] [SESSION]: write the plain-text transcript of a session, as
# resolve_session picks it, to transcript.txt in its folder, mode 0600, through
# transcript.txt.part and a rename, and name it on stderr; --stdout prints it instead and writes
# nothing. Exits 0 when done, 1 for a bad session, a missing python3 or pyte or a failed render,
# 2 for a usage error and 3 when there is no session.
cmd_render() {
    local to='' session=''
    local -i count=0
    while (( $# )); do
        case $1 in
            --stdout) to=stdout ;;
            -h | --help) usage; exit 0 ;;
            --)
                shift
                count+=$#
                if (( $# )); then
                    session=$1
                fi
                break
                ;;
            -?*) usage_error "unknown option for render: $1" ;;
            *) session=$1; count+=1 ;;
        esac
        shift
    done
    (( count <= 1 )) || usage_error "render takes one session at most"
    refuse_foreign_root
    read_version
    resolve_session "$session"
    require_python render pyte
    run_render "$to"
    if [[ $to != stdout ]]; then
        msg "transcript $(shown "$SESSION_DIR/transcript.txt")"
    fi
}

# tlogger show [SESSION]: page the transcript of a session with less, without -R and in its
# secure mode; when stdout is not a terminal, or less is missing, print it. LESS, LESSOPEN,
# LESSCLOSE, LESSSECURE_ALLOW, LESS_IS_MORE and MORE are unset, since each can pass options, run
# a command or undo that mode. transcript.txt is rendered first unless transcript_fresh finds it
# newer than the logs. Exits as render does, or with less's status.
cmd_show() {
    local session=''
    local -i count=0
    while (( $# )); do
        case $1 in
            -h | --help) usage; exit 0 ;;
            --)
                shift
                count+=$#
                if (( $# )); then
                    session=$1
                fi
                break
                ;;
            -?*) usage_error "unknown option for show: $1" ;;
            *) session=$1; count+=1 ;;
        esac
        shift
    done
    (( count <= 1 )) || usage_error "show takes one session at most"
    refuse_foreign_root
    resolve_session "$session"
    if ! transcript_fresh; then
        read_version
        require_python show pyte
        run_render
    fi
    if [[ -t 1 ]] && command -v less > /dev/null 2>&1; then
        env -u LESS -u LESSOPEN -u LESSCLOSE -u LESSSECURE_ALLOW -u LESS_IS_MORE -u MORE \
            LESSSECURE=1 less -- "$SESSION_DIR/transcript.txt"
    else
        cat -- "$SESSION_DIR/transcript.txt"
    fi
}

# tlogger replay [--speed N] [--maxdelay S] [SESSION]: replay a session's output.raw at the pace
# of its timing with util-linux scriptreplay, its output filtered as replay_through_filter says.
# scriptreplay reads a copy of the timing in WORK that tlogger_view.py's replay-timing cleans:
# without the H lines, whose comma under a locale such as de_DE stops scriptreplay 2.42, and
# without malformed lines. N becomes --divisor and S --maxdelay; both must be positive decimal
# numbers. input.raw is never replayed, and scriptlive is never run. Exits 0 when done, 1 for a
# bad session, a missing scriptreplay or python3 or a failed replay, 2 for a usage error, 3 when
# there is no session, and 128 plus the signal number after SIGHUP, SIGINT, SIGQUIT or SIGTERM;
# bash ignores SIGQUIT, and the filter's status 131 passes it on.
cmd_replay() {
    local speed='' maxdelay='' session='' opt value
    local -i count=0 status=0
    local -a args
    while (( $# )); do
        case $1 in
            --speed | --maxdelay | --speed=* | --maxdelay=*)
                opt=${1%%=*}
                if [[ $1 == *=* ]]; then
                    value=${1#*=}
                else
                    (( $# >= 2 )) || usage_error "$opt needs a value: a positive decimal number"
                    shift
                    value=$1
                fi
                positive_decimal "$value" ||
                    usage_error "$opt takes a positive decimal number, not '$value'"
                if [[ $opt == --speed ]]; then
                    speed=$value
                else
                    maxdelay=$value
                fi
                ;;
            -h | --help) usage; exit 0 ;;
            --)
                shift
                count+=$#
                if (( $# )); then
                    session=$1
                fi
                break
                ;;
            -?*) usage_error "unknown option for replay: $1" ;;
            *) session=$1; count+=1 ;;
        esac
        shift
    done
    (( count <= 1 )) || usage_error "replay takes one session at most"
    refuse_foreign_root
    resolve_session "$session"
    require_scriptreplay
    require_python replay
    make_work
    "$PYTHON" -I "$SRC_ROOT/libexec/tlogger_view.py" replay-timing \
        < "$SESSION_DIR/timing" > "$WORK/timing" || status=$?
    if (( status )); then
        exit "$status"
    fi
    args=(--log-timing "$WORK/timing" --log-out "$SESSION_DIR/output.raw")
    if [[ -n $speed ]]; then
        args+=(--divisor "$speed")
    fi
    if [[ -n $maxdelay ]]; then
        args+=(--maxdelay "$maxdelay")
    fi
    replay_through_filter "${args[@]}"
}

# =======================================================
#                  SEAL, VERIFY AND LIST
# =======================================================

# Set LIVE for the session folder DIR from its recorder file, '<pid> <starttime> <boot_id>
# <tty_nr>' as the plugin's handshake writes it: yes while that process still runs, that is, the
# boot id has not changed and <pid> has that start time, field 22 of its stat; no once it has
# gone; unknown without a readable recorder file of that form. Reads the boot id and the stat
# under TLOGGER_PROC, default /proc, and starts no process.
recorder_state() {
    local dir=$1 proc=${TLOGGER_PROC:-/proc} line='' pid start boot tty now='' stat=''
    local -a f
    LIVE=unknown
    if [[ -L $dir/recorder || ! -f $dir/recorder || ! -r $dir/recorder ]]; then
        return 0
    fi
    IFS= read -r line < "$dir/recorder" || true
    read -r pid start boot tty <<< "$line" || true
    if [[ ! $pid =~ ^[0-9]+$ || ! $start =~ ^[0-9]+$ || ! $boot =~ ^[0-9a-f-]+$ ]]; then
        return 0
    fi
    LIVE=no
    { now=$(< "$proc/sys/kernel/random/boot_id"); } 2> /dev/null || now=
    if [[ -n $now && $now != "$boot" ]]; then
        return 0
    fi
    { stat=$(< "$proc/$pid/stat"); } 2> /dev/null || stat=
    if [[ $stat != *')'* ]]; then
        return 0
    fi
    read -r -a f <<< "${stat##*)}" || true
    if [[ ${f[19]-} == "$start" ]]; then
        LIVE=yes
    fi
}

# Print the entries of the folder DIR, dot entries included, one full path per line.
dir_entries() {
    local e
    for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        if [[ -e $e || -L $e ]]; then
            printf '%s\n' "$e"
        fi
    done
}

# Succeed when the session folder DIR may be sealed as it is: a real folder of this user's whose
# entries are only SEAL_FILES, each a readable regular file of this user's, not a symlink, with
# output.raw and timing among them, and what SEAL_EXTRAS_RE allows. Else set WHY and fail.
seal_check() {
    local dir=$1 id=${1##*/} e name
    if [[ -L $dir || ! -d $dir || ! -O $dir ]]; then
        WHY="$(shown "$dir") is a symlink, not a folder or another user's"
        return 1
    fi
    while IFS= read -r e; do
        name=${e##*/}
        if [[ " ${SEAL_FILES[*]} " != *" $name "* ]]; then
            if [[ ! $name =~ $SEAL_EXTRAS_RE ]]; then
                WHY="session $id holds $name, which no session holds; seal refuses it"
                return 1
            fi
            continue
        fi
        if [[ -L $e ]]; then
            WHY="$(shown "$e") is a symlink, which tlogger does not follow"
        elif [[ ! -f $e ]]; then
            WHY="$(shown "$e") is not a regular file"
        elif [[ ! -O $e ]]; then
            WHY="$(shown "$e") belongs to another user"
        elif [[ ! -r $e ]]; then
            WHY="cannot read $(shown "$e")"
        fi
        if [[ -n $WHY ]]; then
            return 1
        fi
    done < <(dir_entries "$dir")
    for name in output.raw timing; do
        if [[ ! -f $dir/$name ]]; then
            WHY="$(shown "$dir") holds no $name, so it is not a session folder"
            return 1
        fi
    done
}

# Print the SHA-256 of FILE.
sha256_of() {
    local sum
    sum=$(sha256sum < "$1") || return 1
    printf '%s\n' "${sum%% *}"
}

# Seal the session folder DIR. Refuses a session whose recorder still runs or has no recorder
# file, and one that seal_check refuses. Writes SHA256SUMS over the SEAL_FILES the session holds,
# in their order, through a temp file and a rename; makes them and SHA256SUMS 0400; writes SEAL,
# 0400, with the tlogger version, the UTC time and the SHA-256 of SHA256SUMS; flushes them to
# disk with sync; and appends '<sum>  <id>/SHA256SUMS' to the MANIFEST of the folder that holds
# DIR with manifest_add. A session sealed already only gets its missing MANIFEST line, as long as
# SHA256SUMS still has the sum SEAL names; else it is refused as a mismatch. Sets SEAL_RESULT,
# SEAL_SUM and, on a refusal, WHY; returns 1 on a refusal or a failure.
seal_session() {
    local dir=$1 id=${1##*/} parent=${1%/*} f tmp sum stamp manifest line
    local -a files=() paths=()
    SEAL_RESULT=refused SEAL_SUM='' WHY='' LIVE=''
    manifest=$parent/MANIFEST
    if [[ -e $dir/SEAL || -L $dir/SEAL ]]; then
        SEAL_RESULT=already
        # A seal whose MANIFEST line never got written, as when the MANIFEST was read-only or the
        # run was cut short, gets it now, as long as SHA256SUMS still has the sum SEAL names.
        # Nothing else is written: no SEAL, no SHA256SUMS and no log. A line there already ends it
        # without a write, so that a read-only MANIFEST stays fine, as long as it has the sum
        # SEAL names; manifest_add checks again under its lock.
        line=$(manifest_line "$manifest" "$id")
        if [[ -n $line ]]; then
            if [[ ${line%% *} == "$(seal_sum "$dir" 2> /dev/null)" ]]; then
                return 0
            fi
            SEAL_RESULT=mismatch
            WHY="session $id is sealed, but its line in the MANIFEST holds another sum than its"
            WHY+=" SEAL; tlogger verify $id names what changed"
            return 1
        fi
        if [[ -L $dir/SEAL || ! -f $dir/SEAL || -L $dir/SHA256SUMS || ! -f $dir/SHA256SUMS ]]
        then
            sum=
        else
            sum=$(sha256_of "$dir/SHA256SUMS") || sum=
        fi
        if [[ -z $sum || $sum != "$(seal_sum "$dir" 2> /dev/null)" ]]; then
            SEAL_RESULT=mismatch
            WHY="session $id is sealed, but its SHA256SUMS does not match its SEAL, so seal adds"
            WHY+=" no MANIFEST line; tlogger verify $id names what changed"
            return 1
        fi
        manifest_add "$manifest" "$id" "$sum" 1 || return 1
        if (( MANIFEST_ADDED )); then
            SEAL_RESULT=completed SEAL_SUM=$sum
        fi
        return 0
    fi
    seal_check "$dir" || return 1
    recorder_state "$dir"
    case $LIVE in
        yes)
            SEAL_RESULT=live
            WHY="session $id is still being recorded"
            return 1
            ;;
        unknown)
            WHY="session $id has no recorder file, so tlogger cannot tell whether it is still"
            WHY+=" being recorded"
            return 1
            ;;
    esac
    if [[ -L $manifest || ( -e $manifest && ! -f $manifest ) ]]; then
        WHY="$(shown "$manifest") is a symlink or not a regular file"
        return 1
    fi
    for f in "${SEAL_FILES[@]}"; do
        if [[ -f $dir/$f ]]; then
            files+=("$f")
            paths+=("$dir/$f")
        fi
    done
    tmp=$(mktemp "$dir/SHA256SUMS.part.XXXXXX" 2> /dev/null) || {
        WHY="cannot write in $(shown "$dir")"
        return 1
    }
    TEMP_PATHS+=("$tmp")
    # Two spaces before each name, as sha256sum writes it in text mode, also where it marks
    # binary mode with '*'.
    # The || form, which alone sees a failed redirection (see manifest_add).
    (cd -- "$dir" && sha256sum -- "${files[@]}" | sed 's/^\([0-9a-f]\{64\}\) [ *]/\1  /') \
        2> /dev/null > "$tmp" || {
        WHY="cannot read the logs of session $id"
        return 1
    }
    if ! { chmod 400 -- "$tmp" && mv -f -T -- "$tmp" "$dir/SHA256SUMS"; }; then
        WHY="cannot write $(shown "$dir/SHA256SUMS")"
        return 1
    fi
    chmod 400 -- "${paths[@]}" || {
        WHY="cannot make the logs of session $id read-only"
        return 1
    }
    sum=$(sha256_of "$dir/SHA256SUMS") || {
        WHY="cannot read $(shown "$dir/SHA256SUMS")"
        return 1
    }
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ) || {
        WHY="cannot read the clock"
        return 1
    }
    tmp=$(mktemp "$dir/SEAL.part.XXXXXX" 2> /dev/null) || {
        WHY="cannot write in $(shown "$dir")"
        return 1
    }
    TEMP_PATHS+=("$tmp")
    if ! { printf 'tlogger %s\nsealed %s\nsha256 %s\n' "$VERSION_STR" "$stamp" "$sum" > "$tmp" &&
        chmod 400 -- "$tmp" && mv -f -T -- "$tmp" "$dir/SEAL"; }; then
        WHY="cannot write $(shown "$dir/SEAL")"
        return 1
    fi
    # script -f flushes to the kernel only; sync -d writes the data to the disk, and sync on the
    # folder its entries. An older sync without -d syncs everything.
    sync -d -- "${paths[@]}" "$dir/SHA256SUMS" "$dir/SEAL" 2> /dev/null || sync
    sync -- "$dir" 2> /dev/null || true
    manifest_add "$manifest" "$id" "$sum" 1 || return 1
    # A line there already, from an earlier seal of the same session, must have this sum.
    if (( ! MANIFEST_ADDED )); then
        line=$(manifest_line "$manifest" "$id")
        if [[ ${line%% *} != "$sum" ]]; then
            WHY="session $id is sealed, but the MANIFEST holds another sum for it from an earlier"
            WHY+=" seal; tlogger verify $id names what changed"
            return 1
        fi
    fi
    SEAL_RESULT=sealed SEAL_SUM=$sum
}

# Print the SHA-256 that the 'sha256 ' line of DIR/SEAL names, or nothing.
seal_sum() {
    local line sealed=''
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == 'sha256 '* ]]; then
            sealed=${line#sha256 }
        fi
    done < "$1/SEAL"
    printf '%s\n' "$sealed"
}

# Print the last line of the file MANIFEST for the session ID, '<sum>  ID/SHA256SUMS', or
# nothing. ID is compared as a plain string, never as a pattern, since a session given by a path
# may have any folder name; ENVIRON, unlike awk -v, keeps its backslashes as they are.
manifest_line() {
    if [[ -f $1 && ! -L $1 && -r $1 ]]; then
        TLOGGER_WANT="$2/SHA256SUMS" awk '
            substr($0, 1, 66) ~ /^[0-9a-f]+  $/ && substr($0, 67) == ENVIRON["TLOGGER_WANT"] {
                line = $0
            }
            END { if (line != "") print line }' "$1" 2> /dev/null || true
    fi
}

# Append '<SUM>  <ID>/SHA256SUMS' to the file MANIFEST under flock, creating it with mode 0600,
# and flush it to the disk. With ONLY_MISSING 1, append nothing when a line for ID is there
# already, which it checks under the same lock, so that two seals at once add it once. A file
# that does not end with a newline, as after a write that a full disk cut short, gets one
# first. Sets MANIFEST_ADDED to 1 when it appended, else 0; sets WHY and fails when it cannot
# read or write the file.
manifest_add() {
    local manifest=$1 id=$2 sum=$3 only_missing=${4:-0} rc=0
    MANIFEST_ADDED=0
    if [[ -L $manifest || ( -e $manifest && ! -f $manifest ) ]]; then
        WHY="session $id is sealed, but $(shown "$manifest") is a symlink or not a regular file;"
        WHY+=" tlogger seal $id adds its line once that is fixed"
        return 1
    fi
    # Only the || form sees a failed redirection: bash does not invert that failure under !, so
    # 'if ! ( ... ) 9>> FILE' would pass it as success. stderr is closed before the redirection,
    # so that bash's own message, which names the full path, does not show.
    # shellcheck disable=SC2094 # The reads come before the appends, which go through fd 9.
    (
        flock -x 9 2> /dev/null || true
        if [[ ! -r $manifest ]]; then
            exit 3
        fi
        if (( only_missing )) && [[ -n $(manifest_line "$manifest" "$id") ]]; then
            exit 10
        fi
        if [[ -s $manifest && -n $(tail -c 1 "$manifest") ]]; then
            printf '\n' >&9 || exit 1
        fi
        printf '%s  %s/SHA256SUMS\n' "$sum" "$id" >&9 || exit 1
    ) 2> /dev/null 9>> "$manifest" || rc=$?
    case $rc in
        0) MANIFEST_ADDED=1 ;;
        10) return 0 ;;
        3)
            WHY="session $id is sealed, but cannot read $(shown "$manifest");"
            WHY+=" tlogger seal $id adds its line once that is fixed"
            return 1
            ;;
        *)
            WHY="session $id is sealed, but cannot write its line in $(shown "$manifest");"
            WHY+=" tlogger seal $id adds it once that is fixed"
            return 1
            ;;
    esac
    sync -- "$manifest" 2> /dev/null || true
}

# Check the session folder DIR and print '<id>  <verdict>' on stdout, setting VERDICT. An
# unsealed session is recording, unsealed or unknown, as recorder_state finds its recorder. A
# sealed one is ok, or changed when a file SHA256SUMS names is missing, not a regular file, not
# 0400 or of another sum; when SHA256SUMS or SEAL is not 0400; when the folder holds an entry the
# seal does not cover; when SHA256SUMS does not have the sum SEAL names, or else the sum of its
# MANIFEST line, or has no MANIFEST line. Each finding goes to stderr as '<id>: ...'.
verify_session() {
    local dir=$1 id=${1##*/} line name want got mode e sum sealed='' mline='' manifest
    local -A listed=()
    local changed=0
    if [[ -L $dir/SEAL || ! -f $dir/SEAL ]]; then
        recorder_state "$dir"
        case $LIVE in
            yes) VERDICT=recording ;;
            no) VERDICT=unsealed ;;
            *) VERDICT=unknown ;;
        esac
        printf '%s  %s\n' "$id" "$VERDICT"
        return 0
    fi
    if [[ -L $dir/SHA256SUMS || ! -f $dir/SHA256SUMS ]]; then
        msg "$id: SHA256SUMS is missing"
        changed=1
    else
        while IFS= read -r line || [[ -n $line ]]; do
            if [[ ! $line =~ ^([0-9a-f]{64})\ [\ *](.+)$ ]]; then
                msg "$id: SHA256SUMS holds a line that is not a sum"
                changed=1
                continue
            fi
            want=${BASH_REMATCH[1]} name=${BASH_REMATCH[2]}
            if [[ " ${SEAL_FILES[*]} " != *" $name "* ]]; then
                msg "$id: SHA256SUMS names $name, which no session holds"
                changed=1
                continue
            fi
            listed[$name]=1
            e=$dir/$name
            if [[ -L $e ]]; then
                msg "$id: $name is a symlink"
                changed=1
            elif [[ ! -e $e ]]; then
                msg "$id: $name is missing"
                changed=1
            elif [[ ! -f $e ]]; then
                msg "$id: $name is not a regular file"
                changed=1
            else
                mode=$(stat -c %a -- "$e")
                if [[ $mode != 400 ]]; then
                    msg "$id: $name has mode $mode, not 400"
                    changed=1
                fi
                got=$(sha256_of "$e") || got=
                if [[ $got != "$want" ]]; then
                    msg "$id: $name changed"
                    changed=1
                fi
            fi
        done < "$dir/SHA256SUMS"
        for name in SHA256SUMS SEAL; do
            mode=$(stat -c %a -- "$dir/$name")
            if [[ $mode != 400 ]]; then
                msg "$id: $name has mode $mode, not 400"
                changed=1
            fi
        done
    fi
    while IFS= read -r e; do
        name=${e##*/}
        if [[ -z ${listed[$name]-} && ! $name =~ $SEAL_EXTRAS_RE ]]; then
            msg "$id: $name is not covered by the seal"
            changed=1
        fi
    done < <(dir_entries "$dir")
    # The chain of sums: SHA256SUMS against SEAL, and against the copy in the MANIFEST.
    if [[ -f $dir/SHA256SUMS && ! -L $dir/SHA256SUMS ]]; then
        sum=$(sha256_of "$dir/SHA256SUMS") || sum=
        sealed=$(seal_sum "$dir")
        manifest=${dir%/*}/MANIFEST
        mline=$(manifest_line "$manifest" "$id")
        if [[ $sum != "$sealed" ]]; then
            msg "$id: SHA256SUMS does not match its SEAL"
            changed=1
        elif [[ -z $mline ]]; then
            msg "$id: no line in the MANIFEST names this session"
            changed=1
        elif [[ ${mline%% *} != "$sum" ]]; then
            msg "$id: SHA256SUMS does not match its line in the MANIFEST"
            changed=1
        fi
    fi
    if (( changed )); then
        VERDICT=changed
    else
        VERDICT=ok
    fi
    printf '%s  %s\n' "$id" "$VERDICT"
}

# Print the state that list shows for the session folder DIR: recording, ended or unknown for an
# unsealed one, as recorder_state finds its recorder; for a sealed one sealed, or changed when a
# quick look finds a file of SHA256SUMS missing or not 0400, or SHA256SUMS without the sum that
# SEAL names. verify checks every sum.
list_state() {
    local dir=$1 line name sealed='' sum
    if [[ -L $dir/SEAL || ! -f $dir/SEAL ]]; then
        recorder_state "$dir"
        case $LIVE in
            yes) printf 'recording\n' ;;
            no) printf 'ended\n' ;;
            *) printf 'unknown\n' ;;
        esac
        return 0
    fi
    if [[ -L $dir/SHA256SUMS || ! -f $dir/SHA256SUMS ]]; then
        printf 'changed\n'
        return 0
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        name=${line:66}
        if [[ ! $line =~ ^[0-9a-f]{64}\ [\ *] || -L $dir/$name || ! -f $dir/$name ||
            $(stat -c %a -- "$dir/$name") != 400 ]]; then
            printf 'changed\n'
            return 0
        fi
    done < "$dir/SHA256SUMS"
    sealed=$(seal_sum "$dir")
    sum=$(sha256_of "$dir/SHA256SUMS") || sum=
    if [[ $sum != "$sealed" ]]; then
        printf 'changed\n'
    else
        printf 'sealed\n'
    fi
}

# Print the recorded time of the session folder DIR as HH:MM:SS: the DURATION that script writes
# at its end into timing, else the sum of the delays of its I, O and S lines.
list_duration() {
    local timing=$1/timing
    if [[ -L $timing || ! -f $timing ]]; then
        printf -- '-\n'
        return 0
    fi
    awk '$1 == "H" && $3 == "DURATION" && $4 ~ /^[0-9]+(\.[0-9]+)?$/ { d = $4; found = 1 }
        ($1 == "I" || $1 == "O" || $1 == "S") && $2 ~ /^[0-9]+(\.[0-9]+)?$/ { sum += $2 }
        END {
            if (!found) d = sum
            s = int(d)
            printf "%02d:%02d:%02d\n", int(s / 3600), int(s % 3600 / 60), s % 60
        }' "$timing"
}

# Read the arguments of seal and verify, CMD: one SESSION, --all, or nothing. Sets ARG_SESSION
# and ARG_ALL; exits 2 on a usage error and 0 after -h.
parse_session_args() {
    local cmd=$1
    local -i count=0
    shift
    ARG_SESSION='' ARG_ALL=0
    while (( $# )); do
        case $1 in
            --all) ARG_ALL=1 ;;
            -h | --help) usage; exit 0 ;;
            --)
                shift
                count+=$#
                if (( $# )); then
                    ARG_SESSION=$1
                fi
                break
                ;;
            -?*) usage_error "unknown option for $cmd: $1" ;;
            *) ARG_SESSION=$1; count+=1 ;;
        esac
        shift
    done
    (( count <= 1 )) || usage_error "$cmd takes one session at most"
    if (( ARG_ALL && count )); then
        usage_error "$cmd takes a session or --all, not both"
    fi
}

# Print the notice of seal_session's SEAL_RESULT, sealed or completed, for the session ID.
seal_notice() {
    local sum="SHA-256 of its SHA256SUMS: $SEAL_SUM"
    if [[ $SEAL_RESULT == completed ]]; then
        msg "session $1 is sealed already, and its MANIFEST line is added now; $sum"
    else
        msg "sealed session $1; $sum"
    fi
}

# tlogger seal [SESSION | --all]: seal one session, by default the newest, or with --all every
# session of the log folder and its engagement folders whose recording has ended, by id. Its line
# goes into the MANIFEST of the folder that holds it. Prints 'sealed session <id>; SHA-256 of
# its SHA256SUMS: <sum>' for each one it seals. With --all, sessions still recorded and sessions
# without a recorder file are named and left; sessions sealed already are passed over, unless
# their MANIFEST line is missing, which they get. Exits 0, 1 when a session was refused or could
# not be sealed, 3 without sessions.
cmd_seal() {
    local dir status=0
    parse_session_args seal "$@"
    refuse_foreign_root
    read_version
    if (( ! ARG_ALL )); then
        resolve_session "$ARG_SESSION"
        if ! seal_session "$SESSION_DIR"; then
            if [[ $SEAL_RESULT == live ]]; then
                die 1 "$WHY; seal it once its recording has ended"
            fi
            die 1 "$WHY"
        fi
        case $SEAL_RESULT in
            already) msg "session $SESSION_ID is sealed already" ;;
            *) seal_notice "$SESSION_ID" ;;
        esac
        return 0
    fi
    resolve_logdir
    list_sessions
    for dir in "${SESSIONS[@]}"; do
        if seal_session "$dir"; then
            if [[ $SEAL_RESULT != already ]]; then
                seal_notice "${dir##*/}"
            fi
        elif [[ $SEAL_RESULT == live || $LIVE == unknown ]]; then
            msg "$WHY; not sealed"
        else
            msg "$WHY"
            status=1
        fi
    done
    return "$status"
}

# tlogger verify [SESSION | --all]: check one session, by default the newest, or every session of
# the log folder and its engagement folders with --all, by id, and print '<id>  <verdict>' for
# each (see verify_session). Exits 0 when no sealed session changed and every finished one is
# sealed, 1 when a sealed session changed, 4 when none changed but a finished session is
# unsealed or has no recorder file, 3 without sessions. A session still recorded does not count.
cmd_verify() {
    local dir changed=0
    local -i open=0
    parse_session_args verify "$@"
    refuse_foreign_root
    if (( ARG_ALL )); then
        resolve_logdir
        list_sessions
    else
        resolve_session "$ARG_SESSION"
        SESSIONS=("$SESSION_DIR")
    fi
    for dir in "${SESSIONS[@]}"; do
        verify_session "$dir"
        case $VERDICT in
            changed) changed=1 ;;
            unsealed | unknown) open+=1 ;;
        esac
    done
    if (( changed )); then
        return 1
    fi
    if (( open == 1 )); then
        msg "1 finished session is not sealed; tlogger seal --all seals it"
        return 4
    elif (( open > 1 )); then
        msg "$open finished sessions are not sealed; tlogger seal --all seals them"
        return 4
    fi
}

# tlogger list: print one line per session of the log folder and its engagement folders, oldest
# first, under a header: its id, its state (see list_state), its start in UTC, from its id, its
# recorded time, the number of commands its journal started, whether it has a transcript, and its
# engagement, - for a session directly in the log folder. Exits 0, 3 without sessions.
cmd_list() {
    local dir id state start count engagement row='%-23s  %-9s  %-20s  %8s  %8s  %-10s  %s\n'
    while (( $# )); do
        case $1 in
            -h | --help) usage; exit 0 ;;
            -?*) usage_error "unknown option for list: $1" ;;
            *) usage_error "list takes no session" ;;
        esac
    done
    refuse_foreign_root
    resolve_logdir
    list_sessions
    # shellcheck disable=SC2059 # The format is the row above.
    printf "$row" SESSION STATE 'START (UTC)' DURATION COMMANDS TRANSCRIPT ENGAGEMENT
    for dir in "${SESSIONS[@]}"; do
        id=${dir##*/}
        state=$(list_state "$dir")
        start=${id:0:4}-${id:4:2}-${id:6:2}T${id:9:2}:${id:11:2}:${id:13:2}Z
        count=0
        if [[ -f $dir/commands.tsv && ! -L $dir/commands.tsv ]]; then
            count=$(grep -c "^S"$'\t' "$dir/commands.tsv") || count=0
        fi
        engagement=-
        if [[ ${dir%/*} != "$LOGDIR" ]]; then
            engagement=${dir%/*}
            engagement=${engagement##*/}
        fi
        # shellcheck disable=SC2059
        printf "$row" "$id" "$state" "$start" "$(list_duration "$dir")" "$count" \
            "$( [[ -f $dir/transcript.txt && ! -L $dir/transcript.txt ]] && echo yes || echo no)" \
            "$engagement"
    done
}

# =======================================================
#                           MAIN
# =======================================================

# Run the command named by the first argument. Sets the shell options, a private umask and the
# traps that clean up at every exit; signals exit 128+n. Exits 2 without a known command, and for
# start and stop, which only the plugin runs; a terminal still on the plugin it loaded before an
# install of this version sends them here.
main() {
    local cmd
    set -euo pipefail
    umask 077
    trap cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    (( $# )) || usage_error "no command given"
    cmd=$1
    shift
    case $cmd in
        install) cmd_install "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        mode) cmd_mode "$@" ;;
        engagement) cmd_engagement "$@" ;;
        status) cmd_status "$@" ;;
        doctor) cmd_doctor "$@" ;;
        render) cmd_render "$@" ;;
        show) cmd_show "$@" ;;
        replay) cmd_replay "$@" ;;
        seal) cmd_seal "$@" ;;
        verify) cmd_verify "$@" ;;
        list) cmd_list "$@" ;;
        version | --version) cmd_version "$@" ;;
        help | -h | --help) usage ;;
        start | stop)
            die 2 "tlogger $cmd works only in a zsh terminal that has loaded the plugin; open a new zsh terminal"
            ;;
        *) usage_error "unknown command: $cmd" ;;
    esac
}

# Run main only when the file is executed: `return` succeeds only in a sourced file.
if ! (return 0 2> /dev/null); then
    main "$@"
fi
