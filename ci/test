#!/bin/bash
# ci/test of terminal-logger (the standard's ci/ interface): the bats suite of tests/ in the
# pinned Kali container, through ci/kali-suite, then no-skips over both TAP files. The suite runs
# on a clone of HEAD, so commit first when you run it locally. Needs docker.
set -euo pipefail
# kalilinux/kali-rolling:latest, pinned by its multi-platform index digest. CONTRIBUTING.md,
# "Moving the Kali image", tells how to move the pin.
image=kalilinux/kali-rolling@sha256:7997e0581c4f5c185cfe6773d5cae8fcc7c6b79798726ccaabf843af4bcd2013
tapdir=${RUNNER_TEMP:-${TMPDIR:-/tmp}}/kali-suite
mkdir -p "$tapdir"
rm -f "$tapdir/user.tap" "$tapdir/root.tap"
status=0
docker run --rm -v "$PWD:/src:ro" -v "$tapdir:/tap" -w /src "$image" bash /src/ci/kali-suite ||
    status=1
.github/standard/bin/no-skips "$tapdir/user.tap" "$tapdir/root.tap" || status=1
exit "$status"
